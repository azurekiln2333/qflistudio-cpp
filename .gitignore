# Miscellaneous
*.class
*.log
*.pyc
*.pyo
**/__pycache__/
**/local.properties
*.p12
*.cer
*.p7b
*.pfx
*.jks
*.keystore
*.key
*.pem
.env
.env.*
!.env.example
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
# flutter tool 在包目录里落的状态文件（含 workspace 成员）
.flutter
.flutter_tool_state
.pub-cache/
.pub/
**/build/
**/.dart_tool/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 第三方原生解释器源码：按 apps/qfli_c/native/README.md 的命令 clone 进来，
# 不进版本库（上游在 GitLab，自己 clone 比在这里维护一份副本可靠）。
/native/third_party/picoc/

# HarmonyOS 原生构建产物
/apps/qfli_c/ohos/**/build/
/apps/qfli_c/ohos/**/oh_modules/
/apps/qfli_c/ohos/**/node_modules/
/apps/qfli_c/ohos/**/.hvigor/
/apps/qfli_c/ohos/entry/libs/

# The same generated platform directories exist in every language App.
**/ohos/**/build/
**/ohos/**/oh_modules/
**/ohos/**/node_modules/
**/ohos/**/.hvigor/
**/ohos/entry/libs/

# OHOS bundled toolchain. ~64 MB generated by native/toolchain/package-ohos.ps1;
# regenerate it instead of tracking it, like native/build/.
**/ohos/entry/src/main/resources/rawfile/qfli_toolchain/

# Native language runtime build output
**/native/build/

# Content patch builder copies, regenerated by tool/forge_content/build_core_patch.dart.
# Only the .patch diffs in this directory are tracked.
/tool/forge_content/staging/core-patch/*.index
/tool/forge_content/staging/core-patch/*.merged

# Portable agent definitions must survive a fresh clone.
# Keep unknown platform-local files ignored; expose reusable definitions only.
/.agents/*
!/.agents/agents/
!/.agents/skills/
!/.agents/commands/
!/.agents/hooks/
!/.agents/workflow/
!/.agents/workflow.md
/.claude/*
!/.claude/agents/
!/.claude/skills/
!/.claude/commands/
!/.claude/hooks/
!/.claude/workflow/
!/.claude/workflow.md
!/.claude/settings.json
/.codex/*
!/.codex/agents/
!/.codex/skills/
!/.codex/commands/
!/.codex/hooks/
!/.codex/workflow/
!/.codex/workflow.md
**/settings.local.json
**/.runtime/
**/sessions/
**/.cache/

# Other editor runtime state remains local.
/.agent/
/.codebuddy/
/.cursor/
/.gemini/
/.pi/
/.qoder/
/.trae/
/.workbuddy-ai/
/.zcode/

# Durable Trellis knowledge is tracked; .trellis/.gitignore excludes local state.
/.dsh/

# Local diagnostic exports and shell inspection fragments
/_*.txt
/tmp_*.txt
/s[1-5].txt
/rc[1-2].txt
/run_chunk.txt
/corelist.txt
/lib_tree.txt
/.dsh_*.txt
/.dsh_tmp/
/.gitstatus.txt
/.gs.txt
/.st.txt
