# The .trellis/ tree is tracked on purpose so any clone can resume tasks.
# Only truly ephemeral, machine-local artifacts are ignored.
# Retain already-reviewed historical evidence without opening arbitrary new logs.
!/tasks/10-22-offline-standalone-ide/research/.artifacts/**/*.log
!/tasks/10-01-cross-platform-native-runtime/research/ohos-build-2026-10-08.log
# The three ignored curriculum review logs are preserved as sanitized Markdown summaries.

# Python bytecode cache
**/__pycache__/
**/*.pyc

# Developer identity (local, per machine)
.developer

# Current task pointer and live session runtime state
.current-task
.runtime/
.ralph-state.json
.agent-log
.session-id
.plan-log

# Atomic update temp files / backups
*.tmp
*.new
.backup-*/
