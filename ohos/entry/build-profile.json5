
{
  "apiType": 'stageMode',
  "buildOption": {
    "nativeLib": {
      "debugSymbol": {
        "strip": true,
        // Preserve the SDK runtime library used by the packaged static adapters.
        "exclude": [
          "**/libc++_shared.so"
        ]
      }
    },
    "externalNativeOptions": {
      // Signed in-process LLVM/LLD and WASI interpreter; SDK data is a raw asset.
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
