
{
  "apiType": 'stageMode',
  "buildOption": {
    "nativeLib": {
      "debugSymbol": {
        "strip": true,
        // toolchain.json records these installed files' exact SHA256 values.
        "exclude": [
          "**/libqfli_clang.so",
          "**/libqfli-ld.lld-.so",
          "**/libqfli_executor.so",
          "**/libc++_shared.so"
        ]
      }
    },
    "externalNativeOptions": {
      // OHOS 侧的原生编译运行桥（NAPI）。工具链本体是预构建的 clang，
      // 运行时由 resources 解压到 App 私有目录，见 native/toolchain/README.md。
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
