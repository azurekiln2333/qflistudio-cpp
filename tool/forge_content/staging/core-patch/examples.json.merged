      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n#include <string.h>\n\nint main(void) {\n    const char *sa = \"98765432109876543210\";\n    const char *sb = \"12345678901234567890\";\n    int la = (int)strlen(sa), lb = (int)strlen(sb);\n    int a[64] = {0}, b[64] = {0}, sum[65] = {0};\n    for (int i = 0; i < la; i++) a[i] = sa[la - 1 - i] - '0';\n    for (int i = 0; i < lb; i++) b[i] = sb[lb - 1 - i] - '0';\n    int n = la > lb ? la : lb;\n    int carry = 0;\n    for (int i = 0; i < n; i++) {\n        int s = a[i] + b[i] + carry;\n        sum[i] = s % 10;\n        carry = s / 10;\n    }\n    if (carry) { sum[n] = carry; n++; }\n    printf(\"sum=\");\n    for (int i = n - 1; i >= 0; i--) printf(\"%d\", sum[i]);\n    printf(\"\\n\");\n    return 0;\n}\n",
      "expectedOutput": "sum=111111111011111111100\n",
