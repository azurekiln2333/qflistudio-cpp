      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 016：break 与 continue",
      "summary": "精确控制循环的进出。",
      "concepts": [
        "break",
        "continue",
        "循环控制",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int sum = 0;\n    for (int i = 1; i <= 10; i++) {\n        if (i % 3 == 0) continue;\n        if (i > 8) break;\n        sum += i;\n    }\n    printf(\"sum=%d\\n\", sum);\n    return 0;\n}\n",
      "expectedOutput": "sum=27\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-016-lesson"
    },
