      "code": "#include <stdio.h>\n\nint main(void) {\n    int sum = 0;\n    for (int i = 1; i <= 100; i++) {\n        sum += i;\n    }\n    printf(\"1..100 sum=%d\\n\", sum);\n    for (int i = 5; i >= 1; i--) {\n        printf(\"%d \", i);\n    }\n    printf(\"go!\\n\");\n    return 0;\n}\n",
      "expectedOutput": "1..100 sum=5050\n5 4 3 2 1 go!\n",
