      "code": "#include <iostream>\n#include <stdexcept>\n#include <string>\n\nclass BalanceError : public std::runtime_error {\npublic:\n    explicit BalanceError(const std::string& msg) : std::runtime_error(msg) {}\n};\n\nvoid withdraw(int balance, int amount) {\n    if (amount > balance) throw BalanceError(\"余额不足\");\n    std::cout << \"取款成功 \" << amount << \"\\n\";\n}\n\nint main() {\n    try {\n        withdraw(100, 30);\n        withdraw(100, 200);\n    } catch (const std::invalid_argument& e) {\n        std::cout << \"参数错误: \" << e.what() << \"\\n\";\n    } catch (const std::exception& e) {\n        std::cout << \"业务错误: \" << e.what() << \"\\n\";\n    }\n    return 0;\n}\n",
      "expectedOutput": "取款成功 30\n业务错误: 余额不足\n",
