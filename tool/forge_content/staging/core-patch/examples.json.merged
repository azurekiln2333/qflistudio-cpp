    {
      "id": "c-example-002",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 002：变量与基本类型",
      "summary": "认识 C 的三种基础类型并打印它们的值。",
      "concepts": [
        "int",
        "double",
        "char",
        "声明与初始化",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int count = 7;\n    double price = 12.5;\n    char grade = 'B';\n    printf(\"count=%d\\n\", count);\n    printf(\"price=%.1f\\n\", price);\n    printf(\"grade=%c\\n\", grade);\n    return 0;\n}\n",
      "expectedOutput": "count=7\nprice=12.5\ngrade=B\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-002-lesson"
    },
    {
      "id": "c-example-003",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 003：格式占位符与 printf 细节",
      "summary": "用占位符对齐数字、控制小数位数。",
      "concepts": [
        "%d",
        "%f",
        "%c",
        "%s",
        "宽度与精度",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    printf(\"[%5d]\\n\", 42);\n    printf(\"[%-5d]\\n\", 42);\n    printf(\"[%05d]\\n\", 42);\n    printf(\"[%.3f]\\n\", 3.14159);\n    printf(\"%s 得分 %d\\n\", \"小明\", 95);\n    return 0;\n}\n",
      "expectedOutput": "[   42]\n[42   ]\n[00042]\n[3.142]\n小明 得分 95\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-003-lesson"
    },
    {
      "id": "c-example-004",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 004：算术运算与整数除法",
      "summary": "加减乘除、取余，以及整数除法的坑。",
      "concepts": [
        "+ - * /",
        "%",
        "整数除法",
        "类型提升",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int a = 7, b = 2;\n    printf(\"%d/%d = %d\\n\", a, b, a / b);\n    printf(\"%d.0/%d = %.2f\\n\", a, b, a / (double)b);\n    printf(\"%d %% %d = %d\\n\", a, b, a % b);\n    return 0;\n}\n",
      "expectedOutput": "7/2 = 3\n7.0/2 = 3.50\n7 % 2 = 1\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-004-lesson"
    },
    {
      "id": "c-example-005",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 005：取余运算的实用场景",
      "summary": "用 % 判断奇偶、求数字各位。",
      "concepts": [
        "%",
        "整除判断",
        "循环取模",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int n = 12345;\n    int digitSum = 0;\n    while (n > 0) {\n        digitSum += n % 10;\n        n /= 10;\n    }\n    printf(\"digitSum=%d\\n\", digitSum);\n    printf(\"even? %d\\n\", 8 % 2 == 0);\n    return 0;\n}\n",
      "expectedOutput": "digitSum=15\neven? 1\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-005-lesson"
    },
    {
      "id": "c-example-006",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 006：运算符优先级与括号",
      "summary": "乘除先于加减，括号最优先。",
