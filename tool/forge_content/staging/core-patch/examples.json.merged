      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "import java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.Future;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        ExecutorService pool = Executors.newFixedThreadPool(3);\n        try {\n            Callable<Integer>[] tasks = new Callable[] {\n                (Callable<Integer>) () -> 100,\n                (Callable<Integer>) () -> 200,\n                (Callable<Integer>) () -> 300\n            };\n            int total = 0;\n            for (Callable<Integer> task : tasks) {\n                Future<Integer> future = pool.submit(task);\n                total += future.get();\n            }\n            System.out.println(\"total=\" + total);\n        } finally {\n            pool.shutdown();\n        }\n    }\n}",
      "expectedOutput": "total=600",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-085"
    },
