      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n#include <stdbool.h>\n\nint main(void) {\n    int x = 10;\n    bool positive = x > 0;\n    bool even = x % 2 == 0;\n    printf(\"positive=%d even=%d\\n\", positive, even);\n    printf(\"5 > 3 = %d\\n\", 5 > 3);\n    printf(\"5 == 3 = %d\\n\", 5 == 3);\n    return 0;\n}\n",
      "expectedOutput": "positive=1 even=1\n5 > 3 = 1\n5 == 3 = 0\n",
