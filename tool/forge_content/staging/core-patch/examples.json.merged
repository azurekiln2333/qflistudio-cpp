      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n\nint main() {\n    int sum = 0;\n    for (int i = 1; i <= 10; ++i) sum += i;\n    std::cout << \"sum=\" << sum << \"\\n\";\n\n    int n = 3;\n    while (n > 0) { std::cout << n << \" \"; --n; }\n    std::cout << \"\\n\";\n\n    int k = 0;\n    do { std::cout << k << \" \"; ++k; } while (k < 3);\n    std::cout << \"\\n\";\n\n    for (int i = 0; i < 10; ++i) {\n        if (i == 5) break;\n        if (i % 2 == 0) continue;\n        std::cout << i << \" \";\n    }\n    std::cout << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "sum=55\n3 2 1 \n0 1 2 \n1 3 \n",
      "inputFixtures": {},
