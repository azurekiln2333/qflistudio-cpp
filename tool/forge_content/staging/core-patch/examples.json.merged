      "id": "java-example-096",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "示例 096：手写 JSON 解析",
      "summary": "不依赖库解析简单 JSON 对象。",
      "concepts": [
        "解析",
        "状态机",
        "字符串"
      ],
      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "import java.util.LinkedHashMap;\nimport java.util.Map;\n\npublic class Main {\n    static int index;\n\n    static Object parse(String text) {\n        index = 0;\n        return parseValue(text);\n    }\n\n    static Object parseValue(String text) {\n        char c = text.charAt(index);\n        if (c == '{') {\n            return parseObject(text);\n        }\n        if (c == '\"') {\n            return parseString(text);\n        }\n        return parseInt(text);\n    }\n\n    static Map<String, Object> parseObject(String text) {\n        Map<String, Object> map = new LinkedHashMap<>();\n        index++;\n        while (text.charAt(index) != '}') {\n            String key = parseString(text);\n            index++; // skip ':'\n            Object value = parseValue(text);\n            map.put(key, value);\n            if (text.charAt(index) == ',') {\n                index++;\n            }\n        }\n        index++;\n        return map;\n    }\n\n    static String parseString(String text) {\n        index++;\n        int start = index;\n        while (text.charAt(index) != '\"') {\n            index++;\n        }\n        String value = text.substring(start, index);\n        index++;\n        return value;\n    }\n\n    static Integer parseInt(String text) {\n        int start = index;\n        while (index < text.length() && Character.isDigit(text.charAt(index))) {\n            index++;\n        }\n        return Integer.parseInt(text.substring(start, index));\n    }\n\n    public static void main(String[] args) {\n        String json = \"{\\\"name\\\":\\\"ann\\\",\\\"age\\\":30}\";\n        Map<?, ?> parsed = (Map<?, ?>) parse(json);\n        System.out.println(\"name=\" + parsed.get(\"name\"));\n        System.out.println(\"age=\" + parsed.get(\"age\"));\n    }\n}",
      "expectedOutput": "name=ann\nage=30",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-096"
    },
