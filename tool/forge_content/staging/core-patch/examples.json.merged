      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int a = 2 + 3 * 4;\n    int b = (2 + 3) * 4;\n    int c = 10;\n    c += 5;\n    c *= 2;\n    printf(\"a=%d b=%d c=%d\\n\", a, b, c);\n    return 0;\n}\n",
      "expectedOutput": "a=14 b=20 c=30\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-006-lesson"
    },
    {
      "id": "c-example-007",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 007：类型转换",
      "summary": "自动提升与显式 (type) 强制转换。",
      "concepts": [
        "隐式转换",
        "强制转换",
