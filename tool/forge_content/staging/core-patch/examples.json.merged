      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n\nclass Base {\npublic:\n    virtual ~Base() = default;\n};\nclass Derived : public Base {\npublic:\n    void hello() const { std::cout << \"derived\\n\"; }\n};\n\nint main() {\n    double d = 3.9;\n    int i = static_cast<int>(d);\n    std::cout << i << \"\\n\";\n    Base* b = new Derived();\n    if (auto* p = dynamic_cast<Derived*>(b)) {\n        p->hello();\n    }\n    Base* plain = new Base();\n    std::cout << (dynamic_cast<Derived*>(plain) == nullptr) << \"\\n\";\n    delete b;\n    delete plain;\n    return 0;\n}\n",
      "expectedOutput": "3\nderived\n1\n",
