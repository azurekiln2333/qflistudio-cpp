    {
      "id": "cpp-example-098",
      "language": "cpp",
      "type": "cpp",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "示例 098：编译期多态与运行期多态对比",
      "summary": "对比模板（编译期）与虚函数（运行期）多态的适用场景与取舍。",
      "concepts": [
        "编译期多态",
        "运行期多态",
        "性能",
        "灵活性",
        "标准：c++20"
      ],
      "source": "QFLI C++ 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n#include <memory>\n#include <vector>\n\n// 运行期多态：可在运行期选择实现\nstruct Operation {\n    virtual ~Operation() = default;\n    virtual int apply(int x) const = 0;\n};\nstruct Double : Operation {\n    int apply(int x) const override { return x * 2; }\n};\nstruct Square : Operation {\n    int apply(int x) const override { return x * x; }\n};\n\n// 编译期多态：零开销、可内联（函数对象而非类层次）\nstruct DoubleOp { int operator()(int x) const { return x * 2; } };\nstruct SquareOp { int operator()(int x) const { return x * x; } };\n\ntemplate <typename Op>\nint applyStatic(int x) { return Op{}(x); }\n\nint main() {\n    std::vector<std::unique_ptr<Operation>> ops;\n    ops.push_back(std::make_unique<Double>());\n    ops.push_back(std::make_unique<Square>());\n    for (const auto& op : ops) std::cout << op->apply(5) << \" \";\n    std::cout << \"\\n\";\n    std::cout << applyStatic<DoubleOp>(5) << \" \" << applyStatic<SquareOp>(5) << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "10 25 \n10 25\n",
      "inputFixtures": {},
      "templateType": "cpp",
      "sourceLessonId": "cpp-tutorial-098-lesson"
    },
    {
      "id": "cpp-example-099",
      "language": "cpp",
