      "language": "cpp",
      "type": "cpp",
      "locale": "zh-CN",
      "level": "intermediate",
      "title": "示例 058：迭代器类别",
      "summary": "区分输入、前向、双向、随机访问迭代器的能力差异。",
      "concepts": [
        "迭代器类别",
        "随机访问",
        "双向",
        "算法约束",
        "标准：c++17"
      ],
      "source": "QFLI C++ 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <forward_list>\n#include <iostream>\n#include <list>\n#include <vector>\n\nint main() {\n    std::vector<int> v = {1, 2, 3};\n    std::list<int> l = {4, 5, 6};\n    std::forward_list<int> f = {7, 8, 9};\n    std::cout << v[1] << \"\\n\";           // 随机访问\n    auto lit = l.begin();\n    ++lit; --lit;                          // 双向\n    std::cout << *lit << \"\\n\";\n    int sum = 0;\n    for (int x : f) sum += x;               // 前向遍历\n    std::cout << sum << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "2\n4\n24\n",
      "inputFixtures": {},
      "templateType": "cpp",
      "sourceLessonId": "cpp-tutorial-058-lesson"
    },
