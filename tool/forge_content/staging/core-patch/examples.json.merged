      "code": "#include <stdio.h>\n\nint main(void) {\n    int temperature = 30;\n    if (temperature >= 28) {\n        printf(\"天气炎热\\n\");\n    } else {\n        printf(\"天气舒适\\n\");\n    }\n    return 0;\n}\n",
