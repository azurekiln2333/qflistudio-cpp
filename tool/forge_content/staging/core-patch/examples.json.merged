      "code": "#include <iostream>\n#include <memory>\n\nstruct Resource {\n    explicit Resource(int id) : id(id) { std::cout << \"acquire \" << id << \"\\n\"; }\n    ~Resource() { std::cout << \"release \" << id << \"\\n\"; }\n    int id;\n};\n\nint main() {\n    auto a = std::make_unique<Resource>(1);\n    std::cout << a->id << \"\\n\";\n    auto b = std::move(a);  // 所有权转移\n    std::cout << (a == nullptr) << \"\\n\";\n    std::cout << b->id << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "acquire 1\n1\n1\n1\nrelease 1\n",
