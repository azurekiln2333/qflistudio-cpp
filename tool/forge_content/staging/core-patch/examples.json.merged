      "updatedAt": "2026-10-11",
      "code": "#include <condition_variable>\n#include <iostream>\n#include <mutex>\n#include <queue>\n#include <thread>\n\nint main() {\n    std::mutex m;\n    std::condition_variable cv;\n    std::queue<int> q;\n    bool done = false;\n    int total = 0;\n\n    std::thread producer([&] {\n        for (int i = 1; i <= 5; ++i) {\n            {\n                std::lock_guard<std::mutex> lock(m);\n                q.push(i);\n            }\n            cv.notify_one();\n        }\n        {\n            std::lock_guard<std::mutex> lock(m);\n            done = true;\n        }\n        cv.notify_one();\n    });\n\n    std::thread consumer([&] {\n        while (true) {\n            std::unique_lock<std::mutex> lock(m);\n            cv.wait(lock, [&] { return !q.empty() || done; });\n            if (q.empty() && done) break;\n            total += q.front();\n            q.pop();\n        }\n    });\n\n    producer.join();\n    consumer.join();\n    std::cout << \"total=\" << total << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "total=15\n",
      "inputFixtures": {},
      "templateType": "cpp",
      "sourceLessonId": "cpp-tutorial-091-lesson"
    },
