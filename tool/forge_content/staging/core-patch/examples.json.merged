      "code": "#include <iostream>\n#include <thread>\n#include <vector>\n\nint main() {\n    const int n = 4;\n    std::vector<int> results(n, 0);\n    std::vector<std::thread> workers;\n    for (int i = 0; i < n; ++i) {\n        workers.emplace_back([i, &results] { results[i] = (i + 1) * (i + 1); });\n    }\n    for (auto& t : workers) t.join();\n    int sum = 0;\n    for (int x : results) sum += x;\n    std::cout << \"sum=\" << sum << \"\\n\";\n    return 0;\n}\n",
