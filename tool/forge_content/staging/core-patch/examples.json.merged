      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n#include <memory>\n#include <string>\n\nclass AnyPrinter {\npublic:\n    template <typename T>\n    explicit AnyPrinter(T value)\n        : impl_(std::make_unique<Model<T>>(std::move(value))) {}\n    void print() const { impl_->print(); }\nprivate:\n    struct Concept {\n        virtual ~Concept() = default;\n        virtual void print() const = 0;\n    };\n    template <typename T>\n    struct Model : Concept {\n        explicit Model(T v) : value_(std::move(v)) {}\n        void print() const override { std::cout << value_ << \"\\n\"; }\n        T value_;\n    };\n    std::unique_ptr<Concept> impl_;\n};\n\nint main() {\n    AnyPrinter a(42);\n    AnyPrinter b(std::string(\"hi\"));\n    a.print();\n    b.print();\n    return 0;\n}\n",
