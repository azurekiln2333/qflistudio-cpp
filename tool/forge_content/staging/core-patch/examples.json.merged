      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    void *data;\n    size_t elemSize;\n    size_t count;\n} Vector;\n\nvoid vectorInit(Vector *v, size_t elemSize) {\n    v->elemSize = elemSize;\n    v->count = 0;\n    v->data = malloc(elemSize * 4);\n}\nvoid vectorPush(Vector *v, const void *elem) {\n    memcpy((char *)v->data + v->count * v->elemSize, elem, v->elemSize);\n    v->count++;\n}\nvoid *vectorAt(Vector *v, size_t i) {\n    return (char *)v->data + i * v->elemSize;\n}\n\nint main(void) {\n    Vector v;\n    vectorInit(&v, sizeof(int));\n    for (int i = 1; i <= 3; i++) vectorPush(&v, &i);\n    for (size_t i = 0; i < v.count; i++) printf(\"%d \", *(int *)vectorAt(&v, i));\n    printf(\"\\n\");\n    free(v.data);\n    return 0;\n}\n",
      "expectedOutput": "1 2 3 \n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-082-lesson"
    },
