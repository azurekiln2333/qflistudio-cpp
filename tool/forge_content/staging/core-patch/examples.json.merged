      "code": "#include <stdio.h>\n\n/* 真实项目会拆成：\n     mathutils.h  : int add(int, int); int mul(int, int);\n     mathutils.c  : 两个函数的定义\n     main.c       : #include \"mathutils.h\" 后调用\n   这里把三者合并成单文件，效果一致。 */\n\nint add(int a, int b) { return a + b; }\nint mul(int a, int b) { return a * b; }\n\nint main(void) {\n    printf(\"add=%d mul=%d\\n\", add(20, 22), mul(6, 7));\n    return 0;\n}\n",
