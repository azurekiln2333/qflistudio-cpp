      "code": "#include <cassert>\n#include <iostream>\n#include <vector>\n\nint fibonacci(int n) {\n    if (n < 2) return n;\n    int a = 0, b = 1;\n    for (int i = 2; i <= n; ++i) { int c = a + b; a = b; b = c; }\n    return b;\n}\n\nvoid runTests() {\n    assert(fibonacci(0) == 0);\n    assert(fibonacci(1) == 1);\n    assert(fibonacci(10) == 55);\n}\n\nint main() {\n    runTests();\n    std::cout << \"all tests passed\\n\";\n    return 0;\n}\n",
