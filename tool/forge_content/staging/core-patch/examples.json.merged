      "code": "#include <iostream>\n#include <string>\n#include <string_view>\n\nstd::size_t countVowels(std::string_view s) {\n    std::size_t n = 0;\n    for (char c : s) {\n        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u')\n            ++n;\n    }\n    return n;\n}\n\nint main() {\n    std::string word = \"hello\";\n    std::cout << countVowels(word) << \"\\n\";\n    std::cout << countVowels(\"beautiful\") << \"\\n\";\n    std::string_view sv = word;\n    sv.remove_prefix(1);\n    std::cout << sv << \"\\n\";\n    return 0;\n}\n",
