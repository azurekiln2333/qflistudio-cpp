      "source": "QFLI C++ 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <cstddef>\n#include <iostream>\n#include <memory>\n#include <vector>\n\ntemplate <typename T>\nstruct CountingAllocator {\n    using value_type = T;\n    CountingAllocator() = default;\n    template <typename U>\n    CountingAllocator(const CountingAllocator<U>&) {}\n    T* allocate(std::size_t n) {\n        ++allocations;\n        return static_cast<T*>(::operator new(n * sizeof(T)));\n    }\n    void deallocate(T* p, std::size_t) { ::operator delete(p); }\n    static inline int allocations = 0;\n};\n\nint main() {\n    std::vector<int, CountingAllocator<int>> v;\n    for (int i = 0; i < 100; ++i) v.push_back(i);\n    std::cout << \"size=\" << v.size() << \"\\n\";\n    std::cout << \"allocations>0=\" << (CountingAllocator<int>::allocations > 0) << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "size=100\nallocations>0=1\n",
      "inputFixtures": {},
      "templateType": "cpp",
      "sourceLessonId": "cpp-tutorial-086-lesson"
    },
