      "id": "java-example-073",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "intermediate",
      "title": "示例 073：函数式管道综合",
      "summary": "把 map/filter/sorted/collect 组合成完整数据管道。",
