      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int total = 17, count = 5;\n    double avgImplicit = total / count;\n    double avgExplicit = (double)total / count;\n    int truncated = (int)3.9;\n    printf(\"implicit=%.2f\\n\", avgImplicit);\n    printf(\"explicit=%.2f\\n\", avgExplicit);\n    printf(\"truncated=%d\\n\", truncated);\n    return 0;\n}\n",
      "expectedOutput": "implicit=3.00\nexplicit=3.40\ntruncated=3\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-007-lesson"
    },
    {
