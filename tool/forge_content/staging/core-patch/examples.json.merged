      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n#include <string>\n#include <utility>\n\nclass Box {\npublic:\n    explicit Box(std::string name) : name_(std::move(name)) {}\n    Box(Box&& other) noexcept : name_(std::move(other.name_)) {\n        other.name_ = \"(moved)\";\n        std::cout << \"移动构造\\n\";\n    }\n    const std::string& name() const { return name_; }\nprivate:\n    std::string name_;\n};\n\nint main() {\n    Box a(\"alice\");\n    Box b(std::move(a));\n    std::cout << \"b=\" << b.name() << \"\\n\";\n    std::cout << \"a=\" << a.name() << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "移动构造\nb=alice\na=(moved)\n",
