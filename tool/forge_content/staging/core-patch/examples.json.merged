      "code": "#include <iostream>\n#include <type_traits>\n\n// 老式 SFINAE：只有整型才启用\ntemplate <typename T>\nstd::enable_if_t<std::is_integral_v<T>, T> oldDouble(T x) { return x * 2; }\n\n// 现代 concepts 等价写法（见前几课）\ntemplate <typename T>\nrequires std::is_integral_v<T>\nT newDouble(T x) { return x * 2; }\n\nint main() {\n    std::cout << oldDouble(5) << \"\\n\";\n    std::cout << newDouble(5) << \"\\n\";\n    return 0;\n}\n",
