      "id": "java-example-056",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "intermediate",
      "title": "示例 056：解析简单文本格式",
      "summary": "手写一个 key=value 配置解析器。",
      "concepts": [
        "解析",
        "Map",
        "字符串处理"
      ],
      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "import java.util.HashMap;\nimport java.util.Map;\n\npublic class Main {\n    static Map<String, String> parse(String text) {\n        Map<String, String> result = new HashMap<>();\n        for (String line : text.split(\"\\n\")) {\n            String trimmed = line.trim();\n            if (trimmed.isEmpty() || trimmed.startsWith(\"#\")) {\n                continue;\n            }\n            int index = trimmed.indexOf('=');\n            if (index > 0) {\n                result.put(trimmed.substring(0, index).trim(), trimmed.substring(index + 1).trim());\n            }\n        }\n        return result;\n    }\n\n    public static void main(String[] args) {\n        Map<String, String> config = parse(\"# 注释\\nhost = localhost\\nport=8080\\n\");\n        System.out.println(\"host=\" + config.get(\"host\"));\n        System.out.println(\"port=\" + config.get(\"port\"));\n        System.out.println(\"size=\" + config.size());\n    }\n}",
      "expectedOutput": "host=localhost\nport=8080\nsize=2",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-056"
    },
    {
      "id": "java-example-057",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "intermediate",
      "title": "示例 057：生成器与 Iterable",
      "summary": "实现 Iterable/Iterator 让对象可被 for 遍历。",
      "concepts": [
        "Iterable",
        "Iterator",
        "自定义遍历"
      ],
      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "import java.util.Iterator;\nimport java.util.NoSuchElementException;\n\npublic class Main {\n    static class Range implements Iterable<Integer> {\n        final int from;\n        final int to;\n\n        Range(int from, int to) {\n            this.from = from;\n            this.to = to;\n        }\n\n        @Override\n        public Iterator<Integer> iterator() {\n            return new Iterator<>() {\n                int current = from;\n\n                @Override\n                public boolean hasNext() {\n                    return current < to;\n                }\n\n                @Override\n                public Integer next() {\n                    if (!hasNext()) {\n                        throw new NoSuchElementException();\n                    }\n                    return current++;\n                }\n            };\n        }\n    }\n\n    public static void main(String[] args) {\n        int total = 0;\n        for (int value : new Range(1, 4)) {\n            total += value;\n        }\n        System.out.println(\"total=\" + total);\n    }\n}",
      "expectedOutput": "total=6",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-057"
    },
