      ],
      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "public class Main {\n    public static void main(String[] args) {\n        int[] scores = {88, 92, 79, 95};\n        System.out.println(\"total=\" + total(scores));\n        System.out.println(\"average=\" + average(scores));\n        System.out.println(\"max=\" + max(scores));\n    }\n\n    static int total(int[] values) {\n        int sum = 0;\n        for (int value : values) {\n            sum += value;\n        }\n        return sum;\n    }\n\n    static double average(int[] values) {\n        return (double) total(values) / values.length;\n    }\n\n    static int max(int[] values) {\n        int best = values[0];\n        for (int value : values) {\n            if (value > best) {\n                best = value;\n            }\n        }\n        return best;\n    }\n}",
      "expectedOutput": "total=354\naverage=88.5\nmax=95",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-015"
    },
