      "updatedAt": "2026-10-11",
      "code": "#include <chrono>\n#include <cstdint>\n#include <iostream>\n\nint main() {\n    using clock = std::chrono::steady_clock;\n    const auto start = clock::now();\n    std::uint64_t sum = 0;\n    for (int i = 0; i < 1000000; ++i) sum += static_cast<std::uint64_t>(i);\n    const auto end = clock::now();\n    const auto micros =\n        std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();\n    std::cout << \"sum=\" << sum << \"\\n\";\n    std::cout << \"measured=\" << (micros >= 0) << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "sum=499999500000\nmeasured=1\n",
      "inputFixtures": {},
