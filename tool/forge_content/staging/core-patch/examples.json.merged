      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    char lower = 'g';\n    char upper = lower - 32;\n    printf(\"lower=%c code=%d\\n\", lower, lower);\n    printf(\"upper=%c code=%d\\n\", upper, upper);\n    printf(\"gap=%d\\n\", 'a' - 'A');\n    return 0;\n}\n",
      "expectedOutput": "lower=g code=103\nupper=G code=71\ngap=32\n",
