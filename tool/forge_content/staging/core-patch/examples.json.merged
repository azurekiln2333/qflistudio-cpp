      "id": "cpp-example-075",
      "language": "cpp",
      "type": "cpp",
      "locale": "zh-CN",
      "level": "intermediate",
      "title": "示例 075：库存管理",
      "summary": "综合运用类、容器、算法与错误处理完成一个小型库存系统。",
      "concepts": [
        "综合",
        "类设计",
        "map",
        "算法",
        "标准：c++17"
      ],
      "source": "QFLI C++ 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <iostream>\n#include <optional>\n#include <string>\n#include <unordered_map>\n\nclass Inventory {\npublic:\n    void add(const std::string& item, int count) { items_[item] += count; }\n    std::optional<int> remove(const std::string& item, int count) {\n        auto it = items_.find(item);\n        if (it == items_.end() || it->second < count) return std::nullopt;\n        it->second -= count;\n        return it->second;\n    }\n    int total() const {\n        int sum = 0;\n        for (const auto& [item, count] : items_) sum += count;\n        return sum;\n    }\nprivate:\n    std::unordered_map<std::string, int> items_;\n};\n\nint main() {\n    Inventory inv;\n    inv.add(\"apple\", 10);\n    inv.add(\"pear\", 5);\n    if (auto left = inv.remove(\"apple\", 3)) {\n        std::cout << \"apple left \" << *left << \"\\n\";\n    }\n    if (!inv.remove(\"pear\", 100)) {\n        std::cout << \"pear insufficient\\n\";\n    }\n    std::cout << \"total=\" << inv.total() << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "apple left 7\npear insufficient\ntotal=12\n",
      "inputFixtures": {},
      "templateType": "cpp",
      "sourceLessonId": "cpp-tutorial-075-lesson"
    },
