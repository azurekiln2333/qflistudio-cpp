      "updatedAt": "2026-10-11",
      "code": "#include <algorithm>\n#include <iostream>\n#include <ranges>\n#include <string>\n#include <vector>\n\nstruct Employee {\n    std::string name;\n    int salary;\n};\n\nint main() {\n    std::vector<Employee> staff = {{\"alice\", 5000}, {\"bob\", 3500}, {\"carol\", 7000}};\n    std::ranges::sort(staff, std::less{}, &Employee::salary);\n    for (const auto& e : staff) std::cout << e.name << \":\" << e.salary << \" \";\n    std::cout << \"\\n\";\n    auto it = std::ranges::find(staff, std::string(\"carol\"), &Employee::name);\n    std::cout << \"found \" << it->salary << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "bob:3500 alice:5000 carol:7000 \nfound 7000\n",
      "inputFixtures": {},
