      "code": "#include <stdio.h>\n\nlong factorial(int n) {\n    if (n <= 1) return 1;\n    return n * factorial(n - 1);\n}\n\nint fib(int n) {\n    if (n < 2) return n;\n    return fib(n - 1) + fib(n - 2);\n}\n\nint main(void) {\n    printf(\"5! = %ld\\n\", factorial(5));\n    printf(\"fib(10) = %d\\n\", fib(10));\n    return 0;\n}\n",
      "expectedOutput": "5! = 120\nfib(10) = 55\n",
