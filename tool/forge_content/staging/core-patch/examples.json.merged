      "code": "#include <algorithm>\n#include <iomanip>\n#include <iostream>\n#include <string>\n#include <vector>\n\nstruct Student {\n    std::string name;\n    int score;\n};\n\nint main() {\n    std::vector<Student> students = {{\"小明\", 88}, {\"小红\", 95}, {\"小刚\", 72}};\n    int total = 0;\n    for (const auto& s : students) total += s.score;\n    auto best = std::max_element(\n        students.begin(), students.end(),\n        [](const Student& a, const Student& b) { return a.score < b.score; });\n    std::cout << \"人数 \" << students.size() << \"\\n\";\n    std::cout << \"平均 \" << std::fixed << std::setprecision(1)\n              << static_cast<double>(total) / students.size() << \"\\n\";\n    std::cout << \"最高 \" << best->name << \" \" << best->score << \"\\n\";\n    return 0;\n}\n",
      "expectedOutput": "人数 3\n平均 85.0\n最高 小红 95\n",
