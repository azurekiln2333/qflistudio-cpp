      "id": "c-example-014",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "示例 014：while 循环",
      "summary": "条件为真就一直做。",
      "concepts": [
        "while",
        "条件循环",
        "收敛",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n\nint main(void) {\n    int n = 100;\n    int steps = 0;\n    while (n != 1) {\n        if (n % 2 == 0) n /= 2;\n        else n = 3 * n + 1;\n        steps++;\n    }\n    printf(\"steps=%d\\n\", steps);\n    return 0;\n}\n",
      "expectedOutput": "steps=25\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-014-lesson"
    },
    {
