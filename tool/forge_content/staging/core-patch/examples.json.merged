    {
      "id": "java-example-088",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "示例 088：建造者模式",
      "summary": "用链式建造者构造多参对象。",
      "concepts": [
        "建造者",
        "链式调用",
        "可读性"
      ],
      "source": "QFLI Java 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "code": "public class Main {\n    static final class Request {\n        private final String url;\n        private final String method;\n        private final int timeout;\n\n        private Request(Builder builder) {\n            this.url = builder.url;\n            this.method = builder.method;\n            this.timeout = builder.timeout;\n        }\n\n        static final class Builder {\n            private final String url;\n            private String method = \"GET\";\n            private int timeout = 1000;\n\n            Builder(String url) {\n                this.url = url;\n            }\n\n            Builder method(String method) {\n                this.method = method;\n                return this;\n            }\n\n            Builder timeout(int timeout) {\n                this.timeout = timeout;\n                return this;\n            }\n\n            Request build() {\n                return new Request(this);\n            }\n        }\n\n        String describe() {\n            return method + \" \" + url + \" (\" + timeout + \"ms)\";\n        }\n    }\n\n    public static void main(String[] args) {\n        Request request = new Request.Builder(\"/api\").method(\"POST\").timeout(2000).build();\n        System.out.println(request.describe());\n    }\n}",
      "expectedOutput": "POST /api (2000ms)",
      "inputFixtures": {},
      "templateType": "java",
      "sourceLessonId": "java-tutorial-088"
    },
