      "id": "c-example-095",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "示例 095：基准测试脚手架",
      "summary": "反复运行取平均，减少噪声。",
      "concepts": [
        "基准",
        "计时",
        "重复",
        "对比",
        "标准：c17"
      ],
      "source": "QFLI C 示例（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "code": "#include <stdio.h>\n#include <time.h>\n\nlong sumLoop(int n) { long s = 0; for (int i = 1; i <= n; i++) s += i; return s; }\nlong sumFormula(int n) { return (long)n * (n + 1) / 2; }\n\nint main(void) {\n    volatile long sink = 0;\n    clock_t s1 = clock();\n    for (int r = 0; r < 1000; r++) sink += sumLoop(10000);\n    clock_t e1 = clock();\n    clock_t s2 = clock();\n    for (int r = 0; r < 1000; r++) sink += sumFormula(10000);\n    clock_t e2 = clock();\n    printf(\"sink=%ld\\n\", sink);\n    printf(\"formula faster or equal=%d\\n\", (e2 - s2) <= (e1 - s1));\n    return 0;\n}\n",
      "expectedOutput": "sink=100010000000\nformula faster or equal=1\n",
      "inputFixtures": {},
      "templateType": "c",
      "sourceLessonId": "c-tutorial-095-lesson"
    },
