+      "code": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct Stats Stats;\nstruct Stats { double *data; int size; int capacity; };\n\nStats *statsCreate(int cap) {\n    Stats *s = (Stats *)malloc(sizeof(Stats));\n    s->data = (double *)malloc((size_t)cap * sizeof(double));\n    s->size = 0; s->capacity = cap;\n    return s;\n}\nvoid statsAdd(Stats *s, double v) {\n    if (s->size == s->capacity) {\n        s->capacity *= 2;\n        s->data = (double *)realloc(s->data, (size_t)s->capacity * sizeof(double));\n    }\n    s->data[s->size++] = v;\n}\ndouble statsMean(Stats *s) {\n    double sum = 0;\n    for (int i = 0; i < s->size; i++) sum += s->data[i];\n    return sum / s->size;\n}\ndouble statsMax(Stats *s) {\n    double m = s->data[0];\n    for (int i = 1; i < s->size; i++) if (s->data[i] > m) m = s->data[i];\n    return m;\n}\nvoid statsDestroy(Stats *s) { free(s->data); free(s); }\n\nint main(void) {\n    Stats *s = statsCreate(2);\n    double values[] = {12.0, 7.5, 9.0, 15.0, 4.5};\n    for (int i = 0; i < 5; i++) statsAdd(s, values[i]);\n    printf(\"mean=%.2f\\n\", statsMean(s));\n    printf(\"max=%.1f\\n\", statsMax(s));\n    statsDestroy(s);\n    return 0;\n}\n",
