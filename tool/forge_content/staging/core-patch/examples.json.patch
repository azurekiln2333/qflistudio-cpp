+      "code": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct Entry {\n    char key[16];\n    int value;\n    struct Entry *next;\n} Entry;\n\n#define BUCKETS 8\n\nstatic unsigned hashOf(const char *s) {\n    unsigned h = 5381;\n    while (*s) h = h * 33 + (unsigned char)*s++;\n    return h % BUCKETS;\n}\n\nstatic void put(Entry **table, const char *key, int value) {\n    unsigned b = hashOf(key);\n    for (Entry *e = table[b]; e; e = e->next)\n        if (strcmp(e->key, key) == 0) { e->value = value; return; }\n    Entry *e = (Entry *)malloc(sizeof(Entry));\n    strncpy(e->key, key, sizeof(e->key) - 1);\n    e->key[sizeof(e->key) - 1] = '\\0';\n    e->value = value;\n    e->next = table[b];\n    table[b] = e;\n}\n\nstatic int *get(Entry **table, const char *key) {\n    for (Entry *e = table[hashOf(key)]; e; e = e->next)\n        if (strcmp(e->key, key) == 0) return &e->value;\n    return NULL;\n}\n\nint main(void) {\n    Entry *table[BUCKETS] = {0};\n    put(table, \"one\", 1);\n    put(table, \"two\", 2);\n    put(table, \"one\", 100);\n    int *v = get(table, \"one\");\n    printf(\"one=%d\\n\", v ? *v : -1);\n    printf(\"missing=%d\\n\", get(table, \"nope\") == NULL);\n    for (int i = 0; i < BUCKETS; i++)\n        for (Entry *e = table[i]; e; ) { Entry *n = e->next; free(e); e = n; }\n    return 0;\n}\n",
