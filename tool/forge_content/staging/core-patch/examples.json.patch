+      "code": "#include <cctype>\n#include <iostream>\n#include <memory>\n#include <string>\n\nstruct Expr {\n    virtual ~Expr() = default;\n    virtual int eval() const = 0;\n};\nstruct Num : Expr {\n    explicit Num(int v) : value(v) {}\n    int eval() const override { return value; }\n    int value;\n};\nstruct Add : Expr {\n    Add(std::unique_ptr<Expr> l, std::unique_ptr<Expr> r)\n        : left(std::move(l)), right(std::move(r)) {}\n    int eval() const override { return left->eval() + right->eval(); }\n    std::unique_ptr<Expr> left, right;\n};\nstruct Mul : Expr {\n    Mul(std::unique_ptr<Expr> l, std::unique_ptr<Expr> r)\n        : left(std::move(l)), right(std::move(r)) {}\n    int eval() const override { return left->eval() * right->eval(); }\n    std::unique_ptr<Expr> left, right;\n};\n\nclass Parser {\npublic:\n    explicit Parser(const std::string& text) : s_(text) {}\n    std::unique_ptr<Expr> parse() { return parseAdd(); }\nprivate:\n    std::unique_ptr<Expr> parseAdd() {\n        auto node = parseMul();\n        while (peek() == '+') { ++pos_; node = std::make_unique<Add>(std::move(node), parseMul()); }\n        return node;\n    }\n    std::unique_ptr<Expr> parseMul() {\n        auto node = parseAtom();\n        while (peek() == '*') { ++pos_; node = std::make_unique<Mul>(std::move(node), parseAtom()); }\n        return node;\n    }\n    std::unique_ptr<Expr> parseAtom() {\n        if (peek() == '(') {\n            ++pos_;\n            auto node = parseAdd();\n            ++pos_;  // skip )\n            return node;\n        }\n        int value = 0;\n        while (std::isdigit(static_cast<unsigned char>(peek()))) {\n            value = value * 10 + (s_[pos_++] - '0');\n        }\n        return std::make_unique<Num>(value);\n    }\n    char peek() const { return pos_ < s_.size() ? s_[pos_] : '\\0'; }\n    std::string s_;\n    std::size_t pos_ = 0;\n};\n\nint main() {\n    Parser p(\"1+2*3\");\n    std::cout << p.parse()->eval() << \"\\n\";\n   