      "lessons": [
        {
          "id": "java-tutorial-071-lesson",
          "title": "Java 071：CompletableFuture 异步组合",
          "summary": "用 thenApply/thenCombine 组合异步结果。",
          "concepts": [
            "CompletableFuture",
            "异步",
            "thenApply"
          ],
          "objective": "能用 CompletableFuture 串行与并行组合异步任务。",
          "prerequisites": [],
          "explain": "supplyAsync 提交异步任务；thenApply 变换结果，thenCombine 合并两个任务，join 阻塞等结果（类似 Future.get）。",
          "code": "import java.util.concurrent.CompletableFuture;\n\npublic class Main {\n    public static void main(String[] args) {\n        CompletableFuture<Integer> a = CompletableFuture.supplyAsync(() -> 10);\n        CompletableFuture<Integer> b = CompletableFuture.supplyAsync(() -> 20);\n        int result = a.thenCombine(b, Integer::sum).join();\n        System.out.println(\"sum=\" + result);\n        int doubled = a.thenApply(x -> x * 2).join();\n        System.out.println(\"doubled=\" + doubled);\n    }\n}",
          "output": "sum=30\ndoubled=20",
          "pitfalls": [
            "join/get 在异步未完成时会阻塞。",
            "未捕获的异步异常会随 join 抛出 CompletionException。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 CompletableFuture 相关的一处取值改成你自己的数据后重新运行。"
