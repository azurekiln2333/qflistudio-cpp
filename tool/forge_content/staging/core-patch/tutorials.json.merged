      "lessons": [
        {
          "id": "java-tutorial-060-lesson",
          "title": "Java 060：综合练习：日志分析器",
          "summary": "读取多行日志，统计级别并处理异常行。",
          "concepts": [
            "综合",
            "IO",
            "异常",
            "统计"
          ],
          "objective": "能把 IO、异常、集合组合成一个小分析器。",
          "prerequisites": [],
          "explain": "模拟一行一条日志，按级别统计；对格式不正确的行记入错误计数而不中断。体现「坏数据不崩溃」的健壮性。",
          "code": "import java.util.HashMap;\nimport java.util.Map;\n\npublic class Main {\n    public static void main(String[] args) {\n        String[] lines = {\"INFO boot\", \"ERROR disk\", \"INFO ready\", \"garbage\", \"WARN slow\"};\n        Map<String, Integer> levels = new HashMap<>();\n        int malformed = 0;\n        for (String line : lines) {\n            String[] parts = line.split(\" \", 2);\n            if (parts.length != 2 || parts[0].isEmpty()) {\n                malformed++;\n                continue;\n            }\n            levels.put(parts[0], levels.getOrDefault(parts[0], 0) + 1);\n        }\n        System.out.println(\"INFO=\" + levels.getOrDefault(\"INFO\", 0));\n        System.out.println(\"ERROR=\" + levels.getOrDefault(\"ERROR\", 0));\n        System.out.println(\"malformed=\" + malformed);\n    }\n}",
          "output": "INFO=2\nERROR=1\nmalformed=1",
          "pitfalls": [
            "split 限制次数可避免消息里的空格被切碎。",
            "坏数据要计数而不是直接崩溃。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 综合 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
