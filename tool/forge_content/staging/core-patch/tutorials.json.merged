      "lessons": [
        {
          "id": "java-tutorial-081-lesson",
          "title": "Java 081：并发集合",
          "summary": "用 ConcurrentHashMap 安全并发读写。",
          "concepts": [
            "ConcurrentHashMap",
            "并发集合",
            "分段锁"
          ],
          "objective": "能在多线程下使用并发安全集合。",
          "prerequisites": [],
          "explain": "普通 HashMap 并发修改会损坏内部结构。ConcurrentHashMap 提供高并发下的安全访问，compute/merge 等操作是原子的。",
          "code": "import java.util.concurrent.ConcurrentHashMap;\n\npublic class Main {\n    public static void main(String[] args) throws InterruptedException {\n        ConcurrentHashMap<String, Integer> map = new ConcurrentHashMap<>();\n        Thread[] threads = new Thread[4];\n        for (int i = 0; i < threads.length; i++) {\n            threads[i] = new Thread(() -> {\n                for (int j = 0; j < 500; j++) {\n                    map.merge(\"hits\", 1, Integer::sum);\n                }\n            });\n            threads[i].start();\n        }\n        for (Thread thread : threads) {\n            thread.join();\n        }\n        System.out.println(\"hits=\" + map.get(\"hits\"));\n    }\n}",
          "output": "hits=2000",
          "pitfalls": [
            "复合操作（判断再 put）要改用 compute/merge/putIfAbsent。",
            "ConcurrentHashMap 不允许 null 键值。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 ConcurrentHashMap 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
