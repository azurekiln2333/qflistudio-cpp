      "lessons": [
        {
          "id": "java-tutorial-079-lesson",
          "title": "Java 079：线程池 ExecutorService",
          "summary": "用线程池提交任务并收集结果。",
          "concepts": [
            "ExecutorService",
            "线程池",
            "Future"
          ],
          "objective": "能用线程池提交任务并获取 Future 结果。",
          "prerequisites": [],
          "explain": "直接 new Thread 开销大且难复用。ExecutorService 管理一组线程，submit 返回 Future，shutdown 后等待完成。",
          "code": "import java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.Future;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        ExecutorService pool = Executors.newFixedThreadPool(2);\n        try {\n            Future<Integer> a = pool.submit(() -> 1 + 1);\n            Future<Integer> b = pool.submit(() -> 2 * 3);\n            System.out.println(\"a=\" + a.get());\n            System.out.println(\"b=\" + b.get());\n        } finally {\n            pool.shutdown();\n        }\n    }\n}",
          "output": "a=2\nb=6",
          "pitfalls": [
            "忘记 shutdown 会导致线程不退出。",
            "Future.get 会阻塞直到任务完成。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 ExecutorService 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
