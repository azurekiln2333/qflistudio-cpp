  "entries": [
    {
      "id": "c-tutorial-001",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 001：第一个程序与 printf",
      "summary": "从 main 开始，用 printf 打印第一行文本。",
      "concepts": [
        "main 函数",
        "printf",
        "#include <stdio.h>",
        "return"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-001-lesson",
          "title": "C 001：第一个程序与 printf",
          "summary": "从 main 开始，用 printf 打印第一行文本。",
          "concepts": [
            "main 函数",
            "printf",
            "#include <stdio.h>",
            "return"
          ],
          "objective": "写出并理解一个最小 C 程序的构成：入口、头文件、输出与返回值。",
          "prerequisites": [],
          "explain": "C 程序从 int main(void) 开始执行。printf 声明在 <stdio.h> 里，负责把文本写到标准输出；\\n 是换行符，不写光标会停在行尾。main 返回 0 表示程序正常结束。花括号 { } 圈出函数体，每条语句以分号结尾。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    printf(\"Hello, C!\\n\");\n    printf(\"QFLIForge C17\\n\");\n    return 0;\n}\n",
          "output": "Hello, C!\nQFLIForge C17\n",
          "pitfalls": [
            "忘记 #include <stdio.h> 会让 printf 无法声明。",
            "语句末尾漏分号是最常见的编译错误。",
            "\\n 写成 n 只是普通字符，不会换行。"
          ],
          "exercises": [
            {
              "prompt": "把第二行输出改成你的名字。",
              "hint": "修改第二个 printf 引号里的字符串即可。",
              "answer": "printf(\"你好，我是小明！\\n\");"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-002",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 002：变量与基本类型",
      "summary": "认识 C 的三种基础类型并打印它们的值。",
      "concepts": [
        "int",
        "double",
        "char",
        "声明与初始化"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-002-lesson",
          "title": "C 002：变量与基本类型",
          "summary": "认识 C 的三种基础类型并打印它们的值。",
          "concepts": [
            "int",
            "double",
            "char",
            "声明与初始化"
          ],
          "objective": "用 int / double / char 存储整数、小数和单个字符。",
          "prerequisites": [
            "C 001"
          ],
          "explain": "C 是静态类型语言：变量先声明类型再使用。int 存整数，double 存带小数的数，char 存单个字符（用单引号）。声明时可以直接初始化，例如 int age = 18;。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int count = 7;\n    double price = 12.5;\n    char grade = 'B';\n    printf(\"count=%d\\n\", count);\n    printf(\"price=%.1f\\n\", price);\n    printf(\"grade=%c\\n\", grade);\n    return 0;\n}\n",
          "output": "count=7\nprice=12.5\ngrade=B\n",
          "pitfalls": [
            "char 用单引号 'a'，用双引号是字符串。",
            "未初始化的局部变量含垃圾值，打印前务必赋值。"
          ],
          "exercises": [
            {
              "prompt": "再加一个 double 变量 weight 并打印到两位小数。",
              "hint": "格式占位符用 %.2f。",
              "answer": "double weight = 60.5;\nprintf(\"weight=%.2f\\n\", weight);"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-003",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 003：格式占位符与 printf 细节",
      "summary": "用占位符对齐数字、控制小数位数。",
      "concepts": [
        "%d",
        "%f",
        "%c",
        "%s",
        "宽度与精度"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-003-lesson",
          "title": "C 003：格式占位符与 printf 细节",
          "summary": "用占位符对齐数字、控制小数位数。",
          "concepts": [
            "%d",
            "%f",
            "%c",
            "%s",
            "宽度与精度"
          ],
          "objective": "掌握常用格式占位符和最小宽度/精度控制。",
          "prerequisites": [
            "C 002"
          ],
          "explain": "printf 用 %d 打印整数、%f 打印浮点、%c 打印字符、%s 打印字符串。%5d 表示占 5 列右对齐，%-5d 左对齐，%.3f 表示保留三位小数。占位符个数和参数必须一一对应，类型也要匹配。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    printf(\"[%5d]\\n\", 42);\n    printf(\"[%-5d]\\n\", 42);\n    printf(\"[%05d]\\n\", 42);\n    printf(\"[%.3f]\\n\", 3.14159);\n    printf(\"%s 得分 %d\\n\", \"小明\", 95);\n    return 0;\n}\n",
          "output": "[   42]\n[42   ]\n[00042]\n[3.142]\n小明 得分 95\n",
          "pitfalls": [
            "用 %d 打印 double 会得到未定义结果。",
            "占位符与参数数量不一致会读错栈上的后续值。"
          ],
          "exercises": [
            {
              "prompt": "把 3.14159 打印成科学计数法并保留两位小数。",
              "hint": "用 %e 或 %.2e。",
              "answer": "printf(\"%.2e\\n\", 3.14159); // 3.14e+00"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-004",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 004：算术运算与整数除法",
      "summary": "加减乘除、取余，以及整数除法的坑。",
      "concepts": [
        "+ - * /",
        "%",
        "整数除法",
        "类型提升"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-004-lesson",
          "title": "C 004：算术运算与整数除法",
          "summary": "加减乘除、取余，以及整数除法的坑。",
          "concepts": [
            "+ - * /",
            "%",
            "整数除法",
            "类型提升"
          ],
          "objective": "理解整数相除会截断，以及如何得到小数结果。",
          "prerequisites": [
            "C 002"
          ],
          "explain": "两个 int 相除结果仍是 int，小数部分被直接丢弃：7/2 等于 3 而不是 3.5。想得到小数，至少让一个操作数是 double，例如 7.0/2 或 (double)7/2。% 取余数，只能用于整数。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int a = 7, b = 2;\n    printf(\"%d/%d = %d\\n\", a, b, a / b);\n    printf(\"%d.0/%d = %.2f\\n\", a, b, a / (double)b);\n    printf(\"%d %% %d = %d\\n\", a, b, a % b);\n    return 0;\n}\n",
          "output": "7/2 = 3\n7.0/2 = 3.50\n7 % 2 = 1\n",
          "pitfalls": [
            "printf 里输出百分号要写成 %%。",
            "负数取余的结果符号依赖实现，尽量避免对负数取余。"
          ],
          "exercises": [
            {
              "prompt": "把 145 秒换算成「几分几秒」并打印。",
              "hint": "分钟用 /60，秒用 %60。",
              "answer": "int total = 145;\nprintf(\"%d 分 %d 秒\\n\", total / 60, total % 60);"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-005",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 005：取余运算的实用场景",
      "summary": "用 % 判断奇偶、求数字各位。",
      "concepts": [
        "%",
        "整除判断",
        "循环取模"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-005-lesson",
          "title": "C 005：取余运算的实用场景",
          "summary": "用 % 判断奇偶、求数字各位。",
          "concepts": [
            "%",
            "整除判断",
            "循环取模"
          ],
          "objective": "用取余判断奇偶、整除和循环索引。",
          "prerequisites": [
            "C 004"
          ],
          "explain": "n % 2 == 0 判断偶数，n % 10 取个位，n / 10 去掉个位。取余也常用在循环里把一个递增计数映射到固定范围，例如 i % 3 在 0、1、2 之间循环。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int n = 12345;\n    int digitSum = 0;\n    while (n > 0) {\n        digitSum += n % 10;\n        n /= 10;\n    }\n    printf(\"digitSum=%d\\n\", digitSum);\n    printf(\"even? %d\\n\", 8 % 2 == 0);\n    return 0;\n}\n",
          "output": "digitSum=15\neven? 1\n",
          "pitfalls": [
            "循环取各位时忘记更新 n，会死循环。",
            "对 0 取余 a % 0 是未定义行为，会崩溃。"
          ],
          "exercises": [
            {
              "prompt": "判断一个数能否同时被 3 和 5 整除。",
              "hint": "用 n % 15 == 0。",
              "answer": "int n = 30;\nprintf(\"%d\\n\", n % 15 == 0); // 1"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-006",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 006：运算符优先级与括号",
      "summary": "乘除先于加减，括号最优先。",
      "concepts": [
        "优先级",
        "括号",
        "复合赋值"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-006-lesson",
          "title": "C 006：运算符优先级与括号",
          "summary": "乘除先于加减，括号最优先。",
          "concepts": [
            "优先级",
            "括号",
            "复合赋值"
          ],
          "objective": "理解常见优先级并主动加括号避免歧义。",
          "prerequisites": [
            "C 004"
          ],
          "explain": "乘、除、取余的优先级高于加、减，赋值最低。表达式 a + b * c 先算 b*c。复合赋值 +=、-=、*=、/= 把运算和赋值合在一起，a += 3 等价于 a = a + 3。拿不准就加括号。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int a = 2 + 3 * 4;\n    int b = (2 + 3) * 4;\n    int c = 10;\n    c += 5;\n    c *= 2;\n    printf(\"a=%d b=%d c=%d\\n\", a, b, c);\n    return 0;\n}\n",
          "output": "a=14 b=20 c=30\n",
          "pitfalls": [
            "误以为 a + b * c 是从左到右。",
            "复合赋值中间结果会被截断，整数除法要小心。"
          ],
          "exercises": [
            {
              "prompt": "计算 (10 - 2) / (3 + 1) 并打印。",
              "hint": "先算两个括号里的值再相除。",
              "answer": "printf(\"%d\\n\", (10 - 2) / (3 + 1)); // 2"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-007",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 007：类型转换",
      "summary": "自动提升与显式 (type) 强制转换。",
      "concepts": [
        "隐式转换",
        "强制转换",
        "(double)",
        "截断"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-007-lesson",
          "title": "C 007：类型转换",
          "summary": "自动提升与显式 (type) 强制转换。",
          "concepts": [
            "隐式转换",
            "强制转换",
            "(double)",
            "截断"
          ],
          "objective": "在整数与小数之间安全地转换。",
          "prerequisites": [
            "C 004"
          ],
          "explain": "混合类型运算时，较小的类型会自动提升为较大的，例如 int 和 double 混算会提升成 double。反过来把 double 赋值给 int 会截断小数。显式强制转换写成 (double)x，表明这是有意为之。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int total = 17, count = 5;\n    double avgImplicit = total / count;\n    double avgExplicit = (double)total / count;\n    int truncated = (int)3.9;\n    printf(\"implicit=%.2f\\n\", avgImplicit);\n    printf(\"explicit=%.2f\\n\", avgExplicit);\n    printf(\"truncated=%d\\n\", truncated);\n    return 0;\n}\n",
          "output": "implicit=3.00\nexplicit=3.40\ntruncated=3\n",
          "pitfalls": [
            "total / count 已经是整数除法，先除再赋值给 double 也救不回来。",
            "double 转 int 是截断不是四舍五入。"
          ],
          "exercises": [
            {
              "prompt": "把 9 和 2 相除得到 4.50，验证强转的位置。",
              "hint": "写 (double)9 / 2 或 9 / 2.0。",
              "answer": "printf(\"%.2f\\n\", (double)9 / 2); // 4.50"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-008",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 008：字符与 ASCII",
      "summary": "字符按 ASCII 码存储，可参与运算。",
      "concepts": [
        "char",
        "ASCII",
        "字符运算"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-008-lesson",
          "title": "C 008：字符与 ASCII",
          "summary": "字符按 ASCII 码存储，可参与运算。",
          "concepts": [
            "char",
            "ASCII",
            "字符运算"
          ],
          "objective": "理解字符本质是整数编码，可做算术。",
          "prerequisites": [
            "C 002"
          ],
          "explain": "char 实际存的是字符的编码值。'A' 是 65，'a' 是 97。因此 'a' - 'A' 等于 32，可以让小写字母减去 32 变大写。用 %c 打印字符，用 %d 打印它的编码。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    char lower = 'g';\n    char upper = lower - 32;\n    printf(\"lower=%c code=%d\\n\", lower, lower);\n    printf(\"upper=%c code=%d\\n\", upper, upper);\n    printf(\"gap=%d\\n\", 'a' - 'A');\n    return 0;\n}\n",
          "output": "lower=g code=103\nupper=G code=71\ngap=32\n",
          "pitfalls": [
            "只对 ASCII 字母成立，非字母不能这样转换。",
            "char 是否有符号依赖实现，做算术时注意范围。"
          ],
          "exercises": [
            {
              "prompt": "把字符 '5' 转成它代表的整数 5。",
              "hint": "字符数字的编码连续，用 '5' - '0'。",
              "answer": "printf(\"%d\\n\", '5' - '0'); // 5"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-009",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 009：布尔值与比较",
      "summary": "C 用 0 表示假，非 0 表示真。",
      "concepts": [
        "比较运算符",
        "_Bool",
        "stdbool.h",
        "真假"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-009-lesson",
          "title": "C 009：布尔值与比较",
          "summary": "C 用 0 表示假，非 0 表示真。",
          "concepts": [
            "比较运算符",
            "_Bool",
            "stdbool.h",
            "真假"
          ],
          "objective": "用比较得到条件真假，认识 0 假非 0 真。",
          "prerequisites": [
            "C 004"
          ],
          "explain": "C 没有内建 bool 关键字，比较表达式的结果是 int：0 表示假，非 0 表示真。包含 <stdbool.h> 后可以用 bool、true、false。比较运算符有 ==、!=、>、<、>=、<=。注意 = 是赋值，== 才是比较。",
          "code": "#include <stdio.h>\n#include <stdbool.h>\n\nint main(void) {\n    int x = 10;\n    bool positive = x > 0;\n    bool even = x % 2 == 0;\n    printf(\"positive=%d even=%d\\n\", positive, even);\n    printf(\"5 > 3 = %d\\n\", 5 > 3);\n    printf(\"5 == 3 = %d\\n\", 5 == 3);\n    return 0;\n}\n",
          "output": "positive=1 even=1\n5 > 3 = 1\n5 == 3 = 0\n",
          "pitfalls": [
            "把 if (x = 0) 写成赋值，条件永远为假。",
            "浮点数用 == 比较常常失败，应比较差值。"
          ],
          "exercises": [
            {
              "prompt": "判断 15 是否既大于 10 又小于 20。",
              "hint": "用逻辑与 && 连接两个比较。",
              "answer": "printf(\"%d\\n\", 15 > 10 && 15 < 20); // 1"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-010",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 010：if 与 else",
      "summary": "最基础的条件判断。",
      "concepts": [
        "if",
        "else",
        "条件分支"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-010-lesson",
          "title": "C 010：if 与 else",
          "summary": "最基础的条件判断。",
          "concepts": [
            "if",
            "else",
            "条件分支"
          ],
          "objective": "用 if/else 让程序根据条件走不同分支。",
          "prerequisites": [
            "C 009"
          ],
          "explain": "if (条件) 后面跟一段花括号代码，条件为真时执行；else 在条件为假时执行。条件可以是任意表达式，非 0 即为真。花括号即使只有一条语句也建议保留，避免后续增行时出错。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int temperature = 30;\n    if (temperature >= 28) {\n        printf(\"天气炎热\\n\");\n    } else {\n        printf(\"天气舒适\\n\");\n    }\n    return 0;\n}\n",
          "output": "天气炎热\n",
          "pitfalls": [
            "else 会与最近的未配对 if 结合，缩进不能改变结合关系。",
            "条件后误加分号 if (x > 0); 会让分支体变空。"
          ],
          "exercises": [
            {
              "prompt": "把温度改成 20，观察输出变化。",
              "hint": "重新运行即可。",
              "answer": "输出变成「天气舒适」"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-011",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 011：else if 多分支",
      "summary": "成绩分档的经典写法。",
      "concepts": [
        "else if",
        "多分支",
        "区间判断"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-011-lesson",
          "title": "C 011：else if 多分支",
          "summary": "成绩分档的经典写法。",
          "concepts": [
            "else if",
            "多分支",
            "区间判断"
          ],
          "objective": "用 else if 链处理多个互斥区间。",
          "prerequisites": [
            "C 010"
          ],
          "explain": "else if 把多个条件串起来，从上到下依次判断，命中一个就跳过其余。条件的顺序很重要：如果先判断 >= 60 再判断 >= 90，高分会先被低档截住。一般从最严格的条件开始写。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int score = 85;\n    if (score >= 90) {\n        printf(\"优秀\\n\");\n    } else if (score >= 75) {\n        printf(\"良好\\n\");\n    } else if (score >= 60) {\n        printf(\"及格\\n\");\n    } else {\n        printf(\"不及格\\n\");\n    }\n    return 0;\n}\n",
          "output": "良好\n",
          "pitfalls": [
            "条件顺序写反会让宽条件吞掉窄条件。",
            "区间左闭右开要统一，否则边界会漏判。"
          ],
          "exercises": [
            {
              "prompt": "把 score 改成 92，确认落到「优秀」。",
              "hint": ">= 90 先命中。",
              "answer": "输出变成「优秀」"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-012",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 012：switch 分支",
      "summary": "按整数或字符取值选择分支。",
      "concepts": [
        "switch",
        "case",
        "break",
        "default"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-012-lesson",
          "title": "C 012：switch 分支",
          "summary": "按整数或字符取值选择分支。",
          "concepts": [
            "switch",
            "case",
            "break",
            "default"
          ],
          "objective": "用 switch 处理离散取值的多分支。",
          "prerequisites": [
            "C 011"
          ],
          "explain": "switch 把一个整数或字符表达式和多个 case 比较。每个 case 结束后通常写 break，否则会「贯穿」执行下一个 case。default 处理没有命中任何 case 的情况。switch 只能比较整型常量，不能比较区间。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    char op = '*';\n    int a = 6, b = 7;\n    switch (op) {\n        case '+': printf(\"%d\\n\", a + b); break;\n        case '-': printf(\"%d\\n\", a - b); break;\n        case '*': printf(\"%d\\n\", a * b); break;\n        default: printf(\"unknown\\n\"); break;\n    }\n    return 0;\n}\n",
          "output": "42\n",
          "pitfalls": [
            "漏写 break 会让多个分支连续执行。",
            "case 标签必须是编译期常量，不能是变量。"
          ],
          "exercises": [
            {
              "prompt": "增加一个 case '/' 实现整除，并处理除零。",
              "hint": "在 case '/' 里判断 b 是否为 0。",
              "answer": "case '/': if (b != 0) printf(\"%d\\n\", a / b); else printf(\"div0\\n\"); break;"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-013",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 013：for 循环",
      "summary": "计数循环的标准形式。",
      "concepts": [
        "for",
        "循环变量",
        "累加"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-013-lesson",
          "title": "C 013：for 循环",
          "summary": "计数循环的标准形式。",
          "concepts": [
            "for",
            "循环变量",
            "累加"
          ],
          "objective": "用 for 在已知次数下重复执行。",
          "prerequisites": [
            "C 009"
          ],
          "explain": "for (初始化; 条件; 步进) 是最常见的循环写法。初始化只执行一次，每轮结束执行步进，每轮开始检查条件。循环体用花括号包住多条语句。累加是循环最典型的用法：先准备 sum = 0，每轮往里加。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int sum = 0;\n    for (int i = 1; i <= 100; i++) {\n        sum += i;\n    }\n    printf(\"1..100 sum=%d\\n\", sum);\n    for (int i = 5; i >= 1; i--) {\n        printf(\"%d \", i);\n    }\n    printf(\"go!\\n\");\n    return 0;\n}\n",
          "output": "1..100 sum=5050\n5 4 3 2 1 go!\n",
          "pitfalls": [
            "把 i <= n 写成 i < n 会少算一次。",
            "循环变量在 for 头声明时作用域仅限循环体。"
          ],
          "exercises": [
            {
              "prompt": "求 1 到 100 之间所有偶数的和。",
              "hint": "循环里加 if (i % 2 == 0) sum += i;。",
              "answer": "for (int i = 1; i <= 100; i++) if (i % 2 == 0) sum += i;\n// 结果 2550"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-014",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 014：while 循环",
      "summary": "条件为真就一直做。",
      "concepts": [
        "while",
        "条件循环",
        "收敛"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-014-lesson",
          "title": "C 014：while 循环",
          "summary": "条件为真就一直做。",
          "concepts": [
            "while",
            "条件循环",
            "收敛"
          ],
          "objective": "用 while 在次数不确定时循环直到条件不成立。",
          "prerequisites": [
            "C 013"
          ],
          "explain": "while (条件) 在每轮开始检查条件，适合次数事先不确定的场景，比如反复除以 2 直到变成 1。必须保证循环体内有让条件趋向结束的语句，否则会无限循环。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int n = 100;\n    int steps = 0;\n    while (n != 1) {\n        if (n % 2 == 0) n /= 2;\n        else n = 3 * n + 1;\n        steps++;\n    }\n    printf(\"steps=%d\\n\", steps);\n    return 0;\n}\n",
          "output": "steps=25\n",
          "pitfalls": [
            "忘记在循环体内改变条件变量会死循环。",
            "条件写成赋值 while (n = 1) 永远是 1。"
          ],
          "exercises": [
            {
              "prompt": "统计 27 需要多少步到达 1。",
              "hint": "只需把 n 改成 27 再运行。",
              "answer": "int n = 27; // steps=111"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-015",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 015：do-while 至少执行一次",
      "summary": "先做后判断的循环。",
      "concepts": [
        "do-while",
        "后置条件",
        "输入校验"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-015-lesson",
          "title": "C 015：do-while 至少执行一次",
          "summary": "先做后判断的循环。",
          "concepts": [
            "do-while",
            "后置条件",
            "输入校验"
          ],
          "objective": "用 do-while 保证循环体至少执行一次。",
          "prerequisites": [
            "C 014"
          ],
          "explain": "do { ... } while (条件); 先执行循环体再检查条件，所以至少执行一次。适合「先执行、再决定要不要继续」的场景，例如菜单循环。注意 while 后面要有分号。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int values[] = {3, 0, 7, 0};\n    int i = 0;\n    do {\n        printf(\"value=%d\\n\", values[i]);\n        i++;\n    } while (i < 4 && values[i] != 0);\n    return 0;\n}\n",
          "output": "value=3\n",
          "pitfalls": [
            "while 条件后漏分号是语法错误。",
            "do-while 至少执行一次循环体；条件在末尾判断。"
          ],
          "exercises": [
            {
              "prompt": "让循环打印 values 的前两个元素。",
              "hint": "条件是 i < 2 时继续。",
              "answer": "do { printf(\"value=%d\\n\", values[i]); i++; } while (i < 2);"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-016",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 016：break 与 continue",
      "summary": "精确控制循环的进出。",
      "concepts": [
        "break",
        "continue",
        "循环控制"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-016-lesson",
          "title": "C 016：break 与 continue",
          "summary": "精确控制循环的进出。",
          "concepts": [
            "break",
            "continue",
            "循环控制"
          ],
          "objective": "用 break 提前结束、用 continue 跳过本轮。",
          "prerequisites": [
            "C 013"
          ],
          "explain": "break 立即结束整个循环，continue 跳过本轮剩余语句直接进入下一轮。它们只影响最内层循环。查找场景常用 break 命中即停，过滤场景常用 continue 跳过不关心的数据。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int sum = 0;\n    for (int i = 1; i <= 10; i++) {\n        if (i % 3 == 0) continue;\n        if (i > 8) break;\n        sum += i;\n    }\n    printf(\"sum=%d\\n\", sum);\n    return 0;\n}\n",
          "output": "sum=27\n",
          "pitfalls": [
            "在 switch 里 break 只跳出 switch，不跳出外层循环。",
            "continue 在 while 循环里若跳过条件更新会造成死循环。"
          ],
          "exercises": [
            {
              "prompt": "在 1 到 100 中找第一个能被 7 和 5 同时整除的数。",
              "hint": "用 for 加 if (i % 35 == 0) { print; break; }。",
              "answer": "for (int i = 1; i <= 100; i++) if (i % 35 == 0) { printf(\"%d\\n\", i); break; } // 35"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-017",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 017：嵌套循环",
      "summary": "外面管行，里面管列。",
      "concepts": [
        "嵌套循环",
        "外层与内层",
        "乘法表"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-017-lesson",
          "title": "C 017：嵌套循环",
          "summary": "外面管行，里面管列。",
          "concepts": [
            "嵌套循环",
            "外层与内层",
            "乘法表"
          ],
          "objective": "用两层循环遍历二维结构。",
          "prerequisites": [
            "C 013"
          ],
          "explain": "嵌套循环里，外层每走一步，内层完整走一遍。打印乘法表时外层是行号，内层是列号。两层循环的总执行次数是两者次数相乘，层次越深代价越大。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    for (int row = 1; row <= 3; row++) {\n        for (int col = 1; col <= 3; col++) {\n            printf(\"%d*%d=%d \", row, col, row * col);\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
          "output": "1*1=1 1*2=2 1*3=3 \n2*1=2 2*2=4 2*3=6 \n3*1=3 3*2=6 3*3=9 \n",
          "pitfalls": [
            "内外层用同一个循环变量会互相干扰。",
            "换行写在内层会让每列都换行。"
          ],
          "exercises": [
            {
              "prompt": "打印一个 4 行的直角三角形。",
              "hint": "外层 row 1..4，内层 col 1..row。",
              "answer": "for (int r = 1; r <= 4; r++) { for (int c = 1; c <= r; c++) printf(\"*\"); printf(\"\\n\"); }"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-018",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 018：用循环打印图形",
      "summary": "金字塔图形，理解行列与空格的关系。",
      "concepts": [
        "图形打印",
        "空格与星号",
        "行号关系"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-018-lesson",
          "title": "C 018：用循环打印图形",
          "summary": "金字塔图形，理解行列与空格的关系。",
          "concepts": [
            "图形打印",
            "空格与星号",
            "行号关系"
          ],
          "objective": "通过控制空格与星号数量画出对称图形。",
          "prerequisites": [
            "C 017"
          ],
          "explain": "画对称图形要分别控制前导空格数和星号数。第 r 行的空格数是 n - r，星号数是 2*r - 1。把这两个数量算清楚，任何三角形或菱形都能拼出来。",
          "code": "#include <stdio.h>\n\nint main(void) {\n    int n = 4;\n    for (int r = 1; r <= n; r++) {\n        for (int s = 0; s < n - r; s++) printf(\" \");\n        for (int c = 0; c < 2 * r - 1; c++) printf(\"*\");\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
          "output": "   *\n  ***\n *****\n*******\n",
          "pitfalls": [
            "空格和星号的数量公式写错会让图形歪斜。",
            "金字塔的空格数是 n-r，不是 r 本身。"
          ],
          "exercises": [
            {
              "prompt": "在金字塔下面再画一个倒金字塔。",
              "hint": "让 r 从 n 递减到 1，其他公式不变。",
              "answer": "for (int r = n; r >= 1; r--) { for (int s = 0; s < n - r; s++) printf(\" \"); for (int c = 0; c < 2*r-1; c++) printf(\"*\"); printf(\"\\n\"); }"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-019",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 019：函数与原型",
      "summary": "定义函数，学习前置声明。",
      "concepts": [
        "函数",
        "返回类型",
        "参数",
        "函数原型"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-019-lesson",
          "title": "C 019：函数与原型",
          "summary": "定义函数，学习前置声明。",
          "concepts": [
            "函数",
            "返回类型",
            "参数",
            "函数原型"
          ],
          "objective": "把逻辑封装成函数并在 main 前声明原型。",
          "prerequisites": [
            "C 008"
          ],
          "explain": "函数由返回类型、名字、参数表和函数体组成。如果函数定义写在 main 之后，必须在前面写一行原型（也叫声明），让编译器先知道它的样子。void 表示没有参数或没有返回值。",
          "code": "#include <stdio.h>\n\nint square(int x);\nint cube(int x);\n\nint main(void) {\n    printf(\"square(5)=%d\\n\", square(5));\n    printf(\"cube(3)=%d\\n\", cube(3));\n    return 0;\n}\n\nint square(int x) { return x * x; }\nint cube(int x) { return x * x * x; }\n",
          "output": "square(5)=25\ncube(3)=27\n",
          "pitfalls": [
            "漏写原型会让编译器按旧式隐式声明推断，可能报警或出错。",
            "函数返回类型和 return 的值类型要一致。"
          ],
          "exercises": [
            {
              "prompt": "写一个 pow2 函数返回 2 的 n 次方（n 用循环实现）。",
              "hint": "从 1 开始乘 n 次 2。",
              "answer": "int pow2(int n) { int r = 1; for (int i = 0; i < n; i++) r *= 2; return r; }"
            }
          ]
        }
      ]
    },
    {
      "id": "c-tutorial-020",
      "language": "c",
      "type": "c",
      "locale": "zh-CN",
      "level": "beginner",
      "title": "C 020：函数的参数与返回值",
      "summary": "参数是拷贝，返回值带回结果。",
      "concepts": [
        "值传递",
        "多参数",
        "返回多个值?"
      ],
      "source": "QFLI C 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-11",
      "lessons": [
        {
          "id": "c-tutorial-020-lesson",
          "title": "C 020：函数的参数与返回值",
          "summary": "参数是拷贝，返回值带回结果。",
          "concepts": [
            "值传递",
            "多参数",
            "返回多个值?"
          ],
          "objective": "理解参数按值传递，函数内部改动不影响调用方。",
          "prerequisites": [
            "C 019"
          ],
          "explain": "C 的参数默认按值传递：函数拿到的是实参的副本，在函数内修改参数不会影响调用方。想带回多个结果，通常是把结果算好后通过返回值返回一个，或者（中级课）用指针。函数的返回类型决定它能不能被用在表达式里。",
          "code": "#include <stdio.h>\n\nint add(int a, int b) { return a + b; }\nvoid bump(int x) { x = x + 1; }\n\nint main(void) {\n    int v = 10;\n    bump(v);\n    printf(\"after bump v=%d\\n\", v);\n    printf(\"add(20,22)=%d\\n\", add(20, 22));\n    return 0;\n}\n",
          "output": "after bump v=10\nadd(20,22)=42\n",
          "pitfalls": [
            "误以为 bump 能改变 v，其实改的是副本。",
            "void 函数不能用在需要值的表达式里。"
          ],
          "exercises": [
            {
              "prompt": "写一个函数 maxOf 返回两个整数中较大的一个。",
              "hint": "用三元运算符 a > b ? a : b。",
              "answer": "int maxOf(int a, int b) { return a > b ? a : b; }"
            }
          ]
        }
      ]
    },
