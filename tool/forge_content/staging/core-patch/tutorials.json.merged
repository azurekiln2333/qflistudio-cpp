      "lessons": [
        {
          "id": "java-tutorial-066-lesson",
          "title": "Java 066：Collectors 分组与统计",
          "summary": "groupingBy/counting/joining 常见收集器。",
          "concepts": [
            "Collectors",
            "groupingBy",
            "joining"
          ],
          "objective": "能用 Collectors 做分组、连接与统计。",
          "prerequisites": [],
          "explain": "Collectors 提供丰富的收集策略：groupingBy 分组、counting 计数、joining 连接字符串、summingInt 求和。",
          "code": "import java.util.List;\nimport java.util.Map;\nimport java.util.stream.Collectors;\n\npublic class Main {\n    record Fruit(String name, String color) {}\n\n    public static void main(String[] args) {\n        List<Fruit> fruits = List.of(\n            new Fruit(\"apple\", \"red\"),\n            new Fruit(\"banana\", \"yellow\"),\n            new Fruit(\"cherry\", \"red\"));\n        Map<String, List<String>> byColor = fruits.stream()\n            .collect(Collectors.groupingBy(Fruit::color, Collectors.mapping(Fruit::name, Collectors.toList())));\n        System.out.println(\"red=\" + byColor.get(\"red\"));\n        String joined = fruits.stream().map(Fruit::name).collect(Collectors.joining(\",\"));\n        System.out.println(\"joined=\" + joined);\n    }\n}",
          "output": "red=[apple, cherry]\njoined=apple,banana,cherry",
          "pitfalls": [
            "groupingBy 返回 Map，遍历顺序不固定。",
            "joining 需要流元素是字符串。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 Collectors 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
