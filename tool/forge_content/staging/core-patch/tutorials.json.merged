      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-062-lesson",
          "title": "Java 062：内置函数式接口",
          "summary": "Function、Predicate、Supplier、Consumer 的用途。",
          "concepts": [
            "Function",
            "Predicate",
            "Consumer",
            "Supplier"
          ],
          "objective": "能根据输入输出选用内置函数式接口。",
          "prerequisites": [],
          "explain": "java.util.function 提供常用函数式接口：Function 变换、Predicate 判断、Consumer 消费、Supplier 供给，减少了自定义接口的需要。",
          "code": "import java.util.function.Consumer;\nimport java.util.function.Function;\nimport java.util.function.Predicate;\nimport java.util.function.Supplier;\n\npublic class Main {\n    public static void main(String[] args) {\n        Function<Integer, Integer> square = x -> x * x;\n        Predicate<Integer> isEven = x -> x % 2 == 0;\n        Consumer<String> printer = s -> System.out.println(\"consume:\" + s);\n        Supplier<String> supplier = () -> \"supplied\";\n\n        System.out.println(\"square=\" + square.apply(5));\n        System.out.println(\"isEven=\" + isEven.test(4));\n        printer.accept(\"data\");\n        System.out.println(supplier.get());\n    }\n}",
          "output": "square=25\nisEven=true\nconsume:data\nsupplied",
          "pitfalls": [
            "Function<T,R> 两个类型参数别写错顺序。",
            "Predicate 是 test，Consumer 是 accept，名字不同。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 Function 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
