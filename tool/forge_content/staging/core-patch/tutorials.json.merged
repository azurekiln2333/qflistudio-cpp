      "lessons": [
        {
          "id": "java-tutorial-078-lesson",
          "title": "Java 078：Atomic 原子类",
          "summary": "用 AtomicInteger 做无锁原子计数。",
          "concepts": [
            "AtomicInteger",
            "CAS",
            "无锁"
          ],
          "objective": "能用原子类替代锁实现简单计数。",
          "prerequisites": [],
          "explain": "原子类基于 CAS（比较并交换）实现无锁并发，incrementAndGet 等操作是原子的，适合简单的共享计数。",
          "code": "import java.util.concurrent.atomic.AtomicInteger;\n\npublic class Main {\n    public static void main(String[] args) throws InterruptedException {\n        AtomicInteger counter = new AtomicInteger();\n        Thread[] threads = new Thread[4];\n        for (int i = 0; i < threads.length; i++) {\n            threads[i] = new Thread(() -> {\n                for (int j = 0; j < 1000; j++) {\n                    counter.incrementAndGet();\n                }\n            });\n            threads[i].start();\n        }\n        for (Thread thread : threads) {\n            thread.join();\n        }\n        System.out.println(\"counter=\" + counter.get());\n    }\n}",
          "output": "counter=4000",
          "pitfalls": [
            "多个原子操作组合起来仍不是原子，需要用锁。",
            "CAS 在高竞争下会自旋重试。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 AtomicInteger 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
