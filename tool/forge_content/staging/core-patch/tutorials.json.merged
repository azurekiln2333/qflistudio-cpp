          ],
          "objective": "能用缓冲流逐行读写文件。",
          "prerequisites": [],
          "explain": "缓冲流减少系统调用，适合大文件。readLine 逐行读取，返回 null 表示结束，配合 try-with-resources 保证关闭。",
          "code": "import java.io.BufferedReader;\nimport java.io.BufferedWriter;\nimport java.io.StringReader;\nimport java.io.StringWriter;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        StringWriter buffer = new StringWriter();\n        try (BufferedWriter writer = new BufferedWriter(buffer)) {\n            writer.write(\"a\");\n            writer.newLine();\n            writer.write(\"b\");\n        }\n        try (BufferedReader reader = new BufferedReader(new StringReader(buffer.toString()))) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                System.out.println(\"line:\" + line);\n            }\n        }\n    }\n}",
          "output": "line:a\nline:b",
          "pitfalls": [
            "readLine 不包含行尾换行符。",
            "流用完必须关闭，否则句柄泄漏。"
          ],
          "exercises": [
