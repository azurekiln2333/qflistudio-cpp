      "lessons": [
        {
          "id": "java-tutorial-069-lesson",
          "title": "Java 069：流与副作用",
          "summary": "forEach 与 peek，以及为什么应避免副作用。",
          "concepts": [
            "forEach",
            "peek",
            "副作用"
          ],
          "objective": "能在终止操作中输出，并知道不应在流里改共享状态。",
          "prerequisites": [],
          "explain": "forEach 是终止操作，用于遍历输出。peek 是调试用中间操作。流应尽量无副作用，避免在中间操作里修改外部集合。",
          "code": "import java.util.List;\n\npublic class Main {\n    public static void main(String[] args) {\n        List<String> names = List.of(\"a\", \"b\", \"c\");\n        names.stream()\n            .peek(name -> System.out.println(\"peek:\" + name))\n            .filter(name -> !name.equals(\"b\"))\n            .forEach(name -> System.out.println(\"keep:\" + name));\n    }\n}",
          "output": "peek:a\nkeep:a\npeek:b\npeek:c\nkeep:c",
          "pitfalls": [
            "peek 无终止操作时不会执行。",
            "在流操作里修改外部集合可能导致错误结果。"
          ],
          "exercises": [
            {
