      "lessons": [
        {
          "id": "java-tutorial-072-lesson",
          "title": "Java 072：Optional 与 Stream 结合",
          "summary": "用 findFirst/filter 返回 Optional 并安全处理。",
          "concepts": [
            "Optional",
            "Stream",
            "findFirst"
          ],
          "objective": "能把流查找结果用 Optional 安全地取用。",
          "prerequisites": [],
          "explain": "findFirst/findAny 返回 Optional，配合 filter 与 orElse/map 可在缺失时优雅处理，避免 null。",
          "code": "import java.util.List;\nimport java.util.Optional;\n\npublic class Main {\n    public static void main(String[] args) {\n        List<String> names = List.of(\"ann\", \"bob\", \"carol\");\n        Optional<String> found = names.stream()\n            .filter(n -> n.startsWith(\"c\"))\n            .findFirst();\n        System.out.println(found.orElse(\"none\"));\n        System.out.println(found.map(String::length).orElse(0));\n        System.out.println(names.stream().filter(n -> n.startsWith(\"z\")).findFirst().orElse(\"none\"));\n    }\n}",
          "output": "carol\n5\nnone",
          "pitfalls": [
            "orElse 的参数总会被求值，成本高时用 orElseGet。",
            "findAny 在并行流里不保证第一个。"
          ],
          "exercises": [
            {
