      "id": "java-tutorial-085",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "Java 085：综合练习：并发下载模拟",
      "summary": "用线程池并发处理任务并汇总结果。",
      "concepts": [
        "综合",
        "线程池",
        "Future"
      ],
      "source": "QFLI Java 教程（原创）",
