      "id": "java-tutorial-093",
      "language": "java",
      "type": "java",
      "locale": "zh-CN",
      "level": "advanced",
      "title": "Java 093：图遍历 DFS/BFS",
      "summary": "用栈/队列实现图搜索。",
      "concepts": [
        "图",
        "DFS",
        "BFS",
        "访问标记"
      ],
      "source": "QFLI Java 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-093-lesson",
          "title": "Java 093：图遍历 DFS/BFS",
          "summary": "用栈/队列实现图搜索。",
          "concepts": [
            "图",
            "DFS",
            "BFS",
            "访问标记"
          ],
          "objective": "能实现广度优先遍历并访问每个节点一次。",
          "prerequisites": [],
          "explain": "BFS 用队列逐层扩展，DFS 用栈深入。都要用 visited 标记避免重复访问与环。",
          "code": "import java.util.ArrayDeque;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Queue;\n\npublic class Main {\n    public static void main(String[] args) {\n        Map<String, List<String>> graph = new HashMap<>();\n        graph.put(\"A\", List.of(\"B\", \"C\"));\n        graph.put(\"B\", List.of(\"D\"));\n        graph.put(\"C\", List.of(\"D\"));\n        graph.put(\"D\", List.of());\n\n        List<String> order = new ArrayList<>();\n        Queue<String> queue = new ArrayDeque<>();\n        Map<String, Boolean> visited = new HashMap<>();\n        queue.add(\"A\");\n        visited.put(\"A\", true);\n        while (!queue.isEmpty()) {\n            String node = queue.poll();\n            order.add(node);\n            for (String next : graph.get(node)) {\n                if (visited.putIfAbsent(next, true) == null) {\n                    queue.add(next);\n                }\n            }\n        }\n        System.out.println(order);\n    }\n}",
          "output": "[A, B, C, D]",
          "pitfalls": [
            "忘记标记 visited 会在环上死循环。",
            "BFS 顺序取决于邻居顺序。"
          ],
          "exercises": [
            {
