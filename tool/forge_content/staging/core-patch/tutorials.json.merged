      "lessons": [
        {
          "id": "java-tutorial-089-lesson",
          "title": "Java 089：策略模式",
          "summary": "把可互换算法封装成策略对象。",
          "concepts": [
            "策略",
            "多态",
            "可扩展"
          ],
          "objective": "能用策略模式替换多个 if/else 分支。",
          "prerequisites": [],
          "explain": "策略模式把每种算法封装成实现同一接口的类，运行时注入不同实现，避免大量分支且便于新增算法。",
          "code": "import java.util.List;\nimport java.util.function.Function;\n\npublic class Main {\n    static int discount(String strategy, int price) {\n        Function<Integer, Integer> fn = switch (strategy) {\n            case \"none\" -> p -> p;\n            case \"percent10\" -> p -> p * 9 / 10;\n            case \"minus20\" -> p -> p - 20;\n            default -> throw new IllegalArgumentException(\"未知策略\");\n        };\n        return fn.apply(price);\n    }\n\n    public static void main(String[] args) {\n        List<String> strategies = List.of(\"none\", \"percent10\", \"minus20\");\n        for (String strategy : strategies) {\n            System.out.println(strategy + \"=\" + discount(strategy, 100));\n        }\n    }\n}",
          "output": "none=100\npercent10=90\nminus20=80",
          "pitfalls": [
            "策略对象应无状态，保持不变性。",
            "简单分支无需强行套模式。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
