      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-077-lesson",
          "title": "Java 077：竞态条件与 synchronized",
          "summary": "多个线程改共享变量会出错，用锁保护。",
          "concepts": [
            "竞态",
            "synchronized",
            "原子性"
          ],
          "objective": "能识别竞态并用 synchronized 修复。",
          "prerequisites": [],
          "explain": "`count++` 不是原子操作（读-改-写），并发下会丢失更新。用 synchronized 让临界区互斥，保证同一时刻只有一个线程执行。",
          "code": "public class Main {\n    static int count = 0;\n\n    static synchronized void increment() {\n        count++;\n    }\n\n    public static void main(String[] args) throws InterruptedException {\n        Thread[] threads = new Thread[4];\n        for (int i = 0; i < threads.length; i++) {\n            threads[i] = new Thread(() -> {\n                for (int j = 0; j < 1000; j++) {\n                    increment();\n                }\n            });\n            threads[i].start();\n        }\n        for (Thread thread : threads) {\n            thread.join();\n        }\n        System.out.println(\"count=\" + count);\n    }\n}",
          "output": "count=4000",
          "pitfalls": [
            "synchronized 保护的对象要一致，否则锁不住。",
            "锁范围过大影响性能，过小则不安全。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 竞态 相关的一处取值改成你自己的数据后重新运行。"
            }
