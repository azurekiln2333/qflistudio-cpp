      "lessons": [
        {
          "id": "java-tutorial-054-lesson",
          "title": "Java 054：序列化基础",
          "summary": "用 Java 序列化将对象转为字节再恢复。",
          "concepts": [
            "Serializable",
            "序列化",
            "往返"
          ],
          "objective": "能序列化一个对象并反序列化回来。",
          "prerequisites": [],
          "explain": "实现 Serializable 的对象可被 ObjectOutputStream 写成字节，再用 ObjectInputStream 读回。用于本地持久化或传输。",
          "code": "import java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.ObjectInputStream;\nimport java.io.ObjectOutputStream;\nimport java.io.Serializable;\n\npublic class Main {\n    record User(String name, int age) implements Serializable {}\n\n    public static void main(String[] args) throws Exception {\n        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {\n            out.writeObject(new User(\"Alice\", 30));\n        }\n        try (ObjectInputStream in = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {\n            Object restored = in.readObject();\n            System.out.println(restored);\n        }\n    }\n}",
          "output": "User[name=Alice, age=30]",
          "pitfalls": [
            "序列化会受类版本影响，用 serialVersionUID 控制。",
            "不要反序列化不可信数据。"
          ],
          "exercises": [
