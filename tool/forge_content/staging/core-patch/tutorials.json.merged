      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-083-lesson",
          "title": "Java 083：volatile 可见性",
          "summary": "volatile 保证可见性但不保证原子性。",
          "concepts": [
            "volatile",
            "可见性",
            "内存模型"
          ],
          "objective": "能解释 volatile 的作用与局限。",
          "prerequisites": [],
          "explain": "volatile 让一个线程的写入对其他线程立即可见，适合状态标志位。但它不保证复合操作（如 ++）的原子性。",
          "code": "public class Main {\n    static volatile boolean running = true;\n\n    public static void main(String[] args) throws InterruptedException {\n        Thread worker = new Thread(() -> {\n            while (running) {\n                // busy wait until the flag flips\n            }\n            System.out.println(\"stopped\");\n        });\n        worker.start();\n        Thread.sleep(100);\n        running = false;\n        worker.join();\n        System.out.println(\"main done\");\n    }\n}",
          "output": "stopped\nmain done",
          "pitfalls": [
            "volatile 不能保证 ++ 的原子性。",
            "无 volatile 时循环可能永远看不到新值。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 volatile 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
