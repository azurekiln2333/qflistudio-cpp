      "concepts": [
        "通配符",
        "上界",
        "下界",
        "PECS"
      ],
      "source": "QFLI Java 教程（原创）",
      "license": "Original QFLI curriculum. CC BY 4.0",
      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-041-lesson",
          "title": "Java 041：泛型通配符",
          "summary": "理解 extends/super 上界下界与 PECS 原则。",
          "concepts": [
            "通配符",
            "上界",
            "下界",
            "PECS"
          ],
          "objective": "能用 extends/super 通配符提高泛型灵活性。",
          "prerequisites": [],
          "explain": "`? extends T` 只能读（生产者），`? super T` 只能写（消费者），即PECS（Producer Extends, Consumer Super）。",
          "code": "import java.util.ArrayList;\nimport java.util.List;\n\npublic class Main {\n    static double sum(List<? extends Number> numbers) {\n        double total = 0;\n        for (Number n : numbers) {\n            total += n.doubleValue();\n        }\n        return total;\n    }\n\n    static void addInts(List<? super Integer> target) {\n        target.add(1);\n        target.add(2);\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"sum=\" + sum(List.of(1, 2.5, 3)));\n        List<Number> numbers = new ArrayList<>();\n        addInts(numbers);\n        System.out.println(numbers);\n    }\n}",
          "output": "sum=6.5\n[1, 2]",
          "pitfalls": [
            "extends 的集合不能 add（除 null）。",
            "super 的集合读出来只能当 Object。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 通配符 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
