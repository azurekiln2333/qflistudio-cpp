      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-075-lesson",
          "title": "Java 075：综合练习：排行榜",
          "summary": "解析得分记录并生成排名。",
          "concepts": [
            "综合",
            "Stream",
            "collect",
            "排序"
          ],
          "objective": "能把集合、流、排序组合成一个排行榜。",
          "prerequisites": [],
          "explain": "把「名字:分数」解析成对象，按分数降序排名，同分按名字升序，练习流管道的真实用法。",
          "code": "import java.util.Comparator;\nimport java.util.List;\n\npublic class Main {\n    record Score(String name, int score) {}\n\n    public static void main(String[] args) {\n        String[] raw = {\"ann:80\", \"bob:95\", \"cara:80\"};\n        List<Score> scores = java.util.Arrays.stream(raw)\n            .map(entry -> entry.split(\":\"))\n            .map(parts -> new Score(parts[0], Integer.parseInt(parts[1])))\n            .toList();\n        List<String> ranking = scores.stream()\n            .sorted(Comparator.comparingInt(Score::score).reversed().thenComparing(Score::name))\n            .map(score -> score.name() + \":\" + score.score())\n            .toList();\n        System.out.println(ranking);\n    }\n}",
          "output": "[bob:95, ann:80, cara:80]",
          "pitfalls": [
            "降序后再按名字升序要用 thenComparing 链式。",
            "解析失败要有容错，这里假定格式正确。"
          ],
          "exercises": [
