          "code": "public class Main {\n    public static void main(String[] args) {\n        int age = 20;\n        double price = 19.9;\n        boolean active = true;\n        char grade = 'A';\n        System.out.println(\"age=\" + age);\n        System.out.println(\"price=\" + price);\n        System.out.println(\"active=\" + active);\n        System.out.println(\"grade=\" + grade);\n    }\n}",
