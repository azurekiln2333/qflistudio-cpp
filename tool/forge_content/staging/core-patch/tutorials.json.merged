          "code": "public class Main {\n    public static void main(String[] args) {\n        String day = \"SAT\";\n        String type = switch (day) {\n            case \"SAT\", \"SUN\" -> \"周末\";\n            default -> \"工作日\";\n        };\n        System.out.println(day + \" -> \" + type);\n    }\n}",
          "output": "SAT -> 周末",
          "pitfalls": [
            "传统 case 忘记 break 会穿透到下一个分支。",
            "switch 表达式所有分支都要有返回值。"
          ],
