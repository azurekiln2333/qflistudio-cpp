      "updatedAt": "2026-10-09",
      "lessons": [
        {
          "id": "java-tutorial-080-lesson",
          "title": "Java 080：Callable 与超时",
          "summary": "带返回值和超时的任务。",
          "concepts": [
            "Callable",
            "超时",
            "Future"
          ],
          "objective": "能用 Callable 返回值并在 get 里设置超时。",
          "prerequisites": [],
          "explain": "Callable 与 Runnable 类似但能返回值并抛异常；Future.get(timeout) 在超时时抛 TimeoutException，避免无限等待。",
          "code": "import java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutionException;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.TimeoutException;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        ExecutorService pool = Executors.newSingleThreadExecutor();\n        try {\n            Callable<String> slow = () -> {\n                Thread.sleep(500);\n                return \"done\";\n            };\n            var future = pool.submit(slow);\n            try {\n                System.out.println(future.get(100, TimeUnit.MILLISECONDS));\n            } catch (TimeoutException e) {\n                System.out.println(\"timeout\");\n            }\n            System.out.println(future.get());\n        } finally {\n            pool.shutdown();\n        }\n    }\n}",
          "output": "timeout\ndone",
          "pitfalls": [
            "超时不会取消任务，需要时手动 cancel。",
            "被中断的 sleep 会抛 InterruptedException。"
          ],
          "exercises": [
            {
              "prompt": "运行示例，观察输出，然后修改程序让结果体现一个新的输入。",
              "hint": "改动示例中的常量或数据，重新编译运行，确认输出随之改变。",
              "answer": "把 Callable 相关的一处取值改成你自己的数据后重新运行。"
            }
          ]
        }
      ]
    },
