          "code": "public class Main {\n    interface Greeter {\n        String name();\n\n        default String greet() {\n            return \"你好, \" + name();\n        }\n    }\n\n    static class Robot implements Greeter {\n        @Override\n        public String name() {\n            return \"R2\";\n        }\n    }\n\n    public static void main(String[] args) {\n        System.out.println(new Robot().greet());\n    }\n}",
          "output": "你好, R2",
          "pitfalls": [
